<Window x:Class="PichalUI.GameLauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PichalUI"
        mc:Ignorable="d"
        Title="Pichal UI"
        Height="760"
        Width="1280"
        MinHeight="640"
        MinWidth="1000"
        Background="Transparent"
        Loaded="Window_Loaded"
        Closed="Window_Closed">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="FocusVisualStyle"
                    Value="{x:Null}"/>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle"
                    Value="{x:Null}"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Border>
            <Border.Background>
                <LinearGradientBrush StartPoint="0,2"
                                     EndPoint="1,2">
                    <GradientStop Color="#1A0A0D"
                                  Offset="-2"/>
                    <GradientStop Color="#FF681220"
                                  Offset="0.1"/>
                    <GradientStop Color="#701320"
                                  Offset="0.5"/>
                    <GradientStop Color="#A81826"
                                  Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="70"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Padding="0"
                    Background="Transparent">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="HeaderTitle"
                               Text="Pichal UI"
                               FontSize="18"
                               Foreground="White"
                               VerticalAlignment="Center"
                               Margin="16,0"
                               Grid.Column="0"/>
                    <Button x:Name="BtnRefresh"
                            Content="Rescan"
                            Margin="6"
                            Width="0"
                            Visibility="Collapsed"/>
                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                Margin="16,0">
                        <Image x:Name="ProfileImage"
                               Stretch="UniformToFill"
                               Height="35"
                               Width="35"
                               Margin="0,0,10,0"/>
                        <TextBlock x:Name="ProfileName"
                                   Text="User"
                                   FontSize="18"
                                   Foreground="White"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border x:Name="BannerArea"
                    Grid.Row="1"
                    Padding="0"
                    Background="Transparent">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Image x:Name="BannerImage"
                           Grid.ColumnSpan="4"
                           Stretch="UniformToFill"
                           Opacity="0.1"
                           IsHitTestVisible="False"
                           Height="0"/>

                    <TextBlock x:Name="BannerText"
                               FontSize="22"
                               Text="Home"
                               FontWeight="Bold"
                               Foreground="White"
                               VerticalAlignment="Center"
                               Margin="16,6"
                               Grid.Column="0"/>
                    <TextBlock x:Name="FriendsMenu"
                               FontSize="22"
                               Text="Friends"
                               FontWeight="Bold"
                               Foreground="#FF776464"
                               VerticalAlignment="Center"
                               Margin="16,6"
                               Grid.Column="1"/>
                    <TextBlock FontSize="22"
                               Text="Settings"
                               FontWeight="Bold"
                               Foreground="Gray"
                               VerticalAlignment="Center"
                               Margin="16,6"
                               Grid.Column="2"/>
                </Grid>
            </Border>

            <Border Grid.Row="2"
                    x:Name="Carousel"
                    Height="400"
                    VerticalAlignment="Center"
                    ClipToBounds="False"
                    Padding="8">
                <ListBox x:Name="GamesListBox"
                         Grid.Row="3"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         ScrollViewer.CanContentScroll="False"
                         VirtualizingStackPanel.IsVirtualizing="False"
                         VerticalAlignment="Top"
                         Height="340"
                         ClipToBounds="False">

                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"
                                        IsItemsHost="True"
                                        VerticalAlignment="Top"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>

                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding"
                                    Value="0"/>
                            <Setter Property="Background"
                                    Value="Transparent"/>
                            <Setter Property="VerticalContentAlignment"
                                    Value="Top"/>
                            <Setter Property="VerticalAlignment"
                                    Value="Top"/>

                            <Setter Property="Margin"
                                    Value="4,40,4,0"/>

                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Grid Background="Transparent"
                                              RenderTransformOrigin="0.5, 0.0">
                                            <Grid.RenderTransform>
                                                <ScaleTransform x:Name="ScaleTrans"
                                                                ScaleX="1.0"
                                                                ScaleY="1.0"/>
                                            </Grid.RenderTransform>
                                            <ContentPresenter/>
                                        </Grid>

                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected"
                                                     Value="True">
                                                <Setter Property="Panel.ZIndex"
                                                        Value="9999"/>
                                                <Trigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="ScaleTrans"
                                                                             Storyboard.TargetProperty="ScaleX"
                                                                             To="1.6"
                                                                             Duration="0:0:0.20"
                                                                             DecelerationRatio="0.6"/>
                                                            <DoubleAnimation Storyboard.TargetName="ScaleTrans"
                                                                             Storyboard.TargetProperty="ScaleY"
                                                                             To="1.6"
                                                                             Duration="0:0:0.20"
                                                                             DecelerationRatio="0.6"/>

                                                            <ThicknessAnimation Storyboard.TargetProperty="Margin"
                                                                                To="45,40,45,0"
                                                                                Duration="0:0:0.20"
                                                                                DecelerationRatio="0.6"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.EnterActions>

                                                <Trigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="ScaleTrans"
                                                                             Storyboard.TargetProperty="ScaleX"
                                                                             To="1.0"
                                                                             Duration="0:0:0.20"
                                                                             DecelerationRatio="0.6"/>
                                                            <DoubleAnimation Storyboard.TargetName="ScaleTrans"
                                                                             Storyboard.TargetProperty="ScaleY"
                                                                             To="1.0"
                                                                             Duration="0:0:0.20"
                                                                             DecelerationRatio="0.6"/>
                                                            <ThicknessAnimation Storyboard.TargetProperty="Margin"
                                                                                To="4,40,4,0"
                                                                                Duration="0:0:0.20"
                                                                                DecelerationRatio="0.6"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.ExitActions>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid VerticalAlignment="Top">
                                <Border x:Name="CardBorder"
                                        Width="150"
                                        Height="150"
                                        CornerRadius="8">
                                    <Border.Background>
                                        <ImageBrush ImageSource="{Binding Cover}"
                                                    Stretch="UniformToFill"/>
                                    </Border.Background>
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="8"
                                                          ShadowDepth="3"
                                                          Opacity="0.4"/>
                                    </Border.Effect>

                                    <Grid x:Name="StoreOverlay"
                                          Visibility="Collapsed">
                                        <StackPanel VerticalAlignment="Center"
                                                    HorizontalAlignment="Center">
                                            <TextBlock Text="⌂"
                                                       FontSize="40"
                                                       Foreground="White"
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock Text="LOJA"
                                                       FontSize="14"
                                                       FontWeight="Bold"
                                                       Foreground="White"
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Canvas>
                                    <TextBlock x:Name="SideTitle"
                                               Text="{Binding Title}"
                                               Foreground="White"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"
                                               Width="300"
                                               Canvas.Left="0"
                                               Canvas.Top="100"
                                               Opacity="0">
                                    </TextBlock>
                                </Canvas>
                            </Grid>

                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                             Value="True">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="SideTitle"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="1.0"
                                                                 Duration="0:0:0.3"/>
                                                <DoubleAnimation Storyboard.TargetName="SideTitle"
                                                                 Storyboard.TargetProperty="(Canvas.Left)"
                                                                 From="120"
                                                                 To="155"
                                                                 Duration="0:0:0.3"
                                                                 DecelerationRatio="0.5"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="SideTitle"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="0.0"
                                                                 Duration="0:0:0.1"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.ExitActions>
                                </DataTrigger>

                                <DataTrigger Binding="{Binding Source}"
                                             Value="System">
                                    <Setter TargetName="StoreOverlay"
                                            Property="Visibility"
                                            Value="Visible"/>
                                    <Setter TargetName="CardBorder"
                                            Property="Background">
                                        <Setter.Value>
                                            <LinearGradientBrush StartPoint="0,0"
                                                                 EndPoint="1,1">
                                                <GradientStop Color="#FF4758"
                                                              Offset="0"/>
                                                <GradientStop Color="#FF2A2F"
                                                              Offset="1"/>
                                            </LinearGradientBrush>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Border Grid.Row="3"
                    x:Name="InfoArea"
                    Background="Transparent"
                    Padding="0"
                    Visibility="Visible">

                <Grid HorizontalAlignment="Center"
                        Width="1150">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="0,0,0,20">
                        <Image x:Name="HeroCover"
                               Width="0"
                                Height="0"
                                Visibility="Collapsed"/>
                        <StackPanel>
                            <TextBlock x:Name="HeroTitle"
                                       Text="Select a game"
                                       FontSize="36"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       Height="Auto"
                                    Width="Auto"/>
                            <StackPanel Orientation="Horizontal"
                                    Margin="0,10,0,0">
                                <Button x:Name="StartBtn"
                                        Content="JOGAR"
                                        Width="140"
                                        Height="40"
                                        Background="#FFCC00"
                                        FontWeight="Bold"
                                        Margin="0,0,10,0"/>
                                <Button x:Name="InstallBtn"
                                        Content="Instalar"
                                        Width="100"
                                        Height="40"
                                        Visibility="Collapsed"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <Border Grid.Row="1"
                            CornerRadius="16"
                            Margin="0,0,0,20"
                            Background="#B44B111B"
                            Padding="20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="300"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="300"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Game Completion"
                                           Foreground="White"
                                           FontWeight="SemiBold"
                                           FontSize="16"/>
                                <TextBlock x:Name="Info_CompletionPercent"
                                           Text="0%"
                                           FontSize="48"
                                           FontWeight="Bold"
                                           Foreground="White"
                                           Margin="0,5,0,15"/>
                                <TextBlock x:Name="Info_OwnedOn"
                                           Text="Source: Steam"
                                           Foreground="LightGray"
                                           FontSize="14"
                                           Margin="0,0,0,15"/>
                                <TextBlock Text="Achievements"
                                           Foreground="White"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,5"/>
                                <ListBox x:Name="Info_AchievementsList"
                                         Height="140"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Foreground="LightGray"
                                         ScrollViewer.VerticalScrollBarVisibility="Hidden"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                    Margin="20,0">
                                <TextBlock Text="News and Updates"
                                           Foreground="White"
                                           FontWeight="SemiBold"
                                           FontSize="16"/>
                                <TextBox x:Name="Info_Feed"
                                         Text="Loading..."
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Foreground="LightGray"
                                         TextWrapping="Wrap"
                                         IsReadOnly="True"
                                         Height="250"
                                         Margin="0,5,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <Grid Margin="0,0,0,20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Total Playtime"
                                                Foreground="White"
                                                FontSize="12"/>
                                        <TextBlock x:Name="Info_Playtime"
                                                Text="0.0 hrs"
                                                Foreground="White"
                                                FontSize="20"
                                                FontWeight="Bold"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Last Played"
                                                Foreground="White"
                                                FontSize="12"/>
                                        <TextBlock x:Name="Info_LastPlayed"
                                                Text="-"
                                                Foreground="White"
                                                FontSize="14"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Clips and Screenshots"
                                           Foreground="White"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,5"/>

                                <ListBox x:Name="Info_Screenshots"
                                         Height="160"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Hidden">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"
                                                    Width="280"/>
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="4"
                                                    ClipToBounds="True"
                                                    Margin="0,0,6,6">
                                                <Image Source="{Binding}"
                                                        Height="70"
                                                        Width="125"
                                                        Stretch="UniformToFill"/>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Row="3"
                    x:Name="FriendMenu"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                    </Grid.ColumnDefinitions>
                    <ListBox
                        x:Name="FriendListBox"
                        Width="Auto"
                        Background="Transparent"
                        BorderThickness="0"
                        ScrollViewer.VerticalScrollBarVisibility="Hidden"
                        VirtualizingStackPanel.IsVirtualizing="True"
                        VirtualizingStackPanel.VirtualizationMode="Recycling"
                        KeyboardNavigation.TabNavigation="Local"
                        SelectionMode="Single"
                        Grid.Column="1"
                        HorizontalAlignment="Left"
                        Padding="0">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <!-- remove o focus adorner padrão (ESTA MERDA NÃO FUNCIONA AQUI CRL FODASSE!!!! App.xaml -> Solução) -->
                                <Setter Property="FocusVisualStyle"
                                        Value="{x:Null}"/>
                                <!-- remove o highlight do tab/focus na template abaixo -->
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd"
                                                    Background="Transparent"
                                                    Padding="2"
                                                    CornerRadius="2"
                                                    SnapsToDevicePixels="True">
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </Border>

                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected"
                                                         Value="True">
                                                    <Setter TargetName="Bd"
                                                            Property="Background">
                                                        <Setter.Value>
                                                            <LinearGradientBrush StartPoint="0,2"
                                                                                 EndPoint="1,0">
                                                                <GradientStop Color="#FF4758"
                                                                              Offset="0"/>
                                                                <GradientStop Color="#FFF1A0A8"
                                                                              Offset="0.5"/>
                                                                <GradientStop Color="#FFFF3348"
                                                                              Offset="1.0"/>
                                                            </LinearGradientBrush>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver"
                                                         Value="True">
                                                    <Setter TargetName="Bd"
                                                            Property="Background"
                                                            Value="#FF4758"/>
                                                </Trigger>
                                                <Trigger Property="IsFocused"
                                                         Value="True">
                                                    <Setter TargetName="Bd"
                                                            Property="BorderBrush"
                                                            Value="Transparent"/>
                                                    <Setter TargetName="Bd"
                                                            Property="BorderThickness"
                                                            Value="0"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8"
                                        CornerRadius="2"
                                        Background="#240E12"
                                        Width="400">
                                    <DockPanel>
                                        <Grid Width="40"
                                              Height="40"
                                              Margin="0,0,8,0"
                                              VerticalAlignment="Center">
                                            <Image Source="{Binding AvatarFull}"
                                                   Stretch="UniformToFill"/>
                                        </Grid>

                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding PersonaName}"
                                                       FontWeight="Bold"
                                                       Foreground="White"/>
                                            <TextBlock Text="{Binding SteamId}"
                                                       FontSize="11"
                                                       Foreground="LightGray"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Row="4"
                    Height="30"
                    Background="#06080C"
                    Padding="10,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusLabel"
                               Text="Ready"
                               Foreground="Gray"
                               VerticalAlignment="Center"/>
                    <Button x:Name="BtnConnectSteam"
                            Content="Connect Steam"
                            Grid.Column="1"
                            Width="100"
                            Height="20"
                            Margin="10,0"/>
                    <TextBlock Text="v0.3.0 - alpha"
                               Foreground="Gray"
                               Grid.Column="2"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>