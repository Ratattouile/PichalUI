<Window x:Class="PichalUI.GameLauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PichalUI"
        mc:Ignorable="d"
        Title="Pichal UI"
        Height="760"
        Width="1280"
        MinHeight="640"
        MinWidth="1000"
        Background="Transparent"
        Loaded="Window_Loaded"
        Closed="Window_Closed">

    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush"
                         Color="#FF4758"/>
        <SolidColorBrush x:Key="TextPrimaryBrush"
                         Color="White"/>
        <SolidColorBrush x:Key="PanelBackgroundBrush"
                         Color="#D9101010"/>
        <SolidColorBrush x:Key="textSecondary"
                         Color="Gray"/>

        <Style TargetType="Button">
            <Setter Property="FocusVisualStyle"
                    Value="{x:Null}"/>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle"
                    Value="{x:Null}"/>
        </Style>

        <Style x:Key="SettingsButtonStyle"
               TargetType="Button">
            <Setter Property="Background"
                    Value="#33FFFFFF"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontSize"
                    Value="14"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="Padding"
                    Value="15,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="border"
                                        Property="Background"
                                        Value="#55FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsFocused"
                                     Value="True">
                                <Setter TargetName="border"
                                        Property="Background"
                                        Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground"
                                        Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PlayButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource SettingsButtonStyle}">
            <Setter Property="Background"
                    Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground"
                    Value="Black"/>
            <Setter Property="FontWeight"
                    Value="Bold"/>
            <Setter Property="FontSize"
                    Value="20"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="0">
                            <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused"
                                     Value="True">
                                <Setter TargetName="border"
                                        Property="Background"
                                        Value="White"/>
                                <Setter TargetName="border"
                                        Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="White"
                                                          BlurRadius="20"
                                                          ShadowDepth="0"
                                                          Opacity="0.6"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FocusableItemStyle"
               TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle"
                    Value="{x:Null}"/>
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="Margin"
                    Value="0,0,10,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                CornerRadius="6"
                                BorderThickness="2"
                                BorderBrush="Transparent">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused"
                                     Value="True">
                                <Setter TargetName="Bd"
                                        Property="BorderBrush"
                                        Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="#22FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernSlider"
               TargetType="Slider">
            <Setter Property="IsSnapToTickEnabled"
                    Value="True"/>
            <Setter Property="TickFrequency"
                    Value="5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border Name="TrackBackground"
                                    Background="#33FFFFFF"
                                    Height="4"
                                    CornerRadius="2"
                                    VerticalAlignment="Center"/>
                            <Canvas Name="PART_SelectionRange"/>
                            <Track Name="PART_Track">
                                <Track.Thumb>
                                    <Thumb Width="20"
                                           Height="20">
                                        <Thumb.Template>
                                            <ControlTemplate>
                                                <Border Background="White"
                                                        CornerRadius="10"
                                                        BorderThickness="0">
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="4"
                                                                          Opacity="0.5"/>
                                                    </Border.Effect>
                                                </Border>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToggleSwitch"
               TargetType="CheckBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Border x:Name="Back"
                                    Width="50"
                                    Height="26"
                                    CornerRadius="13"
                                    Background="#444"/>
                            <Ellipse x:Name="Dot"
                                     Width="20"
                                     Height="20"
                                     Fill="White"
                                     HorizontalAlignment="Left"
                                     Margin="3,0,0,0">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="4"
                                                      Opacity="0.3"/>
                                </Ellipse.Effect>
                            </Ellipse>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked"
                                     Value="True">
                                <Setter TargetName="Back"
                                        Property="Background"
                                        Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Dot"
                                        Property="HorizontalAlignment"
                                        Value="Right"/>
                                <Setter TargetName="Dot"
                                        Property="Margin"
                                        Value="0,0,3,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsTabStyle"
               TargetType="RadioButton">
            <Setter Property="Foreground"
                    Value="Gray"/>
            <Setter Property="FontSize"
                    Value="18"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <TextBlock Text="{TemplateBinding Content}"
                                       Foreground="{TemplateBinding Foreground}"
                                       VerticalAlignment="Center"
                                       Margin="20,0"/>
                            <Rectangle x:Name="Indicator"
                                       Width="4"
                                       HorizontalAlignment="Left"
                                       Fill="Transparent"
                                       RadiusX="2"
                                       RadiusY="2"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked"
                                     Value="True">
                                <Setter Property="Foreground"
                                        Value="{DynamicResource TextPrimaryBrush}"/>
                                <Setter Property="FontWeight"
                                        Value="Bold"/>
                                <Setter TargetName="Indicator"
                                        Property="Fill"
                                        Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsFocused"
                                     Value="True">
                                <Setter Property="Foreground"
                                        Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Border x:Name="MainBackground">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,2"
                                     EndPoint="1,2">
                    <GradientStop Color="#1A0A0D"
                                  Offset="-2"/>
                    <GradientStop Color="#FF681220"
                                  Offset="0.1"/>
                    <GradientStop Color="#701320"
                                  Offset="0.5"/>
                    <GradientStop Color="#A81826"
                                  Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="70"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Padding="0"
                    Background="Transparent">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="HeaderTitle"
                               Text="Pichal UI"
                               FontSize="18"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center"
                               Margin="16,0"
                               Grid.Column="0"/>

                    <StackPanel Grid.Column="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <TextBlock x:Name="ClockTime"
                                   Text="12:00"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                        <TextBlock x:Name="ClockDate"
                                   Text="Sáb, 22 Nov"
                                   Foreground="LightGray"
                                   FontSize="12"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                Margin="16,0">
                        <Image x:Name="ProfileImage"
                               Stretch="UniformToFill"
                               Height="35"
                               Width="35"
                               Margin="0,0,10,0"/>
                        <TextBlock x:Name="ProfileName"
                                   Text="User"
                                   FontSize="18"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border x:Name="BannerArea"
                    Grid.Row="1"
                    Padding="0"
                    Background="Transparent">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Image x:Name="BannerImage"
                           Grid.ColumnSpan="4"
                           Stretch="UniformToFill"
                           Opacity="0.1"
                           IsHitTestVisible="False"
                           Height="0"/>
                    <TextBlock x:Name="BannerText"
                               FontSize="22"
                               Text="Home"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center"
                               Margin="16,6"
                               Grid.Column="0"/>
                    <TextBlock x:Name="FriendsMenu"
                               FontSize="22"
                               Text="Friends"
                               FontWeight="Bold"
                               Foreground="{DynamicResource textSecondary}"
                               VerticalAlignment="Center"
                               Margin="16,6"
                               Grid.Column="1"/>
                    <TextBlock x:Name="SettingMenu"
                               FontSize="22"
                               Text="Settings"
                               FontWeight="Bold"
                               Foreground="{DynamicResource textSecondary}"
                               VerticalAlignment="Center"
                               Margin="16,6"
                               Grid.Column="2"/>
                </Grid>
            </Border>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Left"
                        Margin="20,0,0,5"
                        VerticalAlignment="Top"
                        Panel.ZIndex="10">

                <StackPanel.Resources>
                    <Style TargetType="RadioButton"
                           x:Key="FilterPillStyle">
                        <Setter Property="Background"
                                Value="#33FFFFFF"/>
                        <Setter Property="Foreground"
                                Value="White"/>
                        <Setter Property="FontSize"
                                Value="14"/>
                        <Setter Property="FontWeight"
                                Value="SemiBold"/>
                        <Setter Property="Margin"
                                Value="0,0,10,0"/>
                        <Setter Property="Padding"
                                Value="20,8"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="RadioButton">
                                    <Border x:Name="Bd"
                                            Background="{TemplateBinding Background}"
                                            CornerRadius="20">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          Margin="{TemplateBinding Padding}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked"
                                                 Value="True">
                                            <Setter TargetName="Bd"
                                                    Property="Background"
                                                    Value="White"/>
                                            <Setter Property="Foreground"
                                                    Value="Black"/>
                                        </Trigger>
                                        <Trigger Property="IsFocused"
                                                 Value="True">
                                            <Setter TargetName="Bd"
                                                    Property="BorderBrush"
                                                    Value="{DynamicResource AccentBrush}"/>
                                            <Setter TargetName="Bd"
                                                    Property="BorderThickness"
                                                    Value="2"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </StackPanel.Resources>

                <RadioButton Content="Tudo"
                             IsChecked="True"
                             Click="Filter_Click"
                             Tag="All"
                             Style="{StaticResource FilterPillStyle}"
                             Focusable="True"/>
                <RadioButton Content="Recentes"
                             Click="Filter_Click"
                             Tag="Recent"
                             Style="{StaticResource FilterPillStyle}"
                             Focusable="True"/>
                <RadioButton Content="Mais Jogados"
                             Click="Filter_Click"
                             Tag="MostPlayed"
                             Style="{StaticResource FilterPillStyle}"
                             Focusable="True"/>
                <RadioButton Content="Backlog"
                             Click="Filter_Click"
                             Tag="NeverPlayed"
                             Style="{StaticResource FilterPillStyle}"
                             Focusable="True"/>
                <RadioButton Content="☁️"
                             Click="Filter_Click"
                             Tag="NotInstalled"
                             Style="{StaticResource FilterPillStyle}"
                             Focusable="True"/>

            </StackPanel>

            <Border Grid.Row="2"
                    x:Name="Carousel"
                    Height="340"
                    VerticalAlignment="Center"
                    ClipToBounds="False"
                    Padding="8"
                    RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="CarouselSlideTransform"
                                        Y="0"/>
                </Border.RenderTransform>
                <ListBox x:Name="GamesListBox"
                         Grid.Row="3"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         ScrollViewer.CanContentScroll="False"
                         VirtualizingStackPanel.IsVirtualizing="False"
                         VerticalAlignment="Top"
                         Height="340"
                         ClipToBounds="False">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"
                                        IsItemsHost="True"
                                        VerticalAlignment="Top"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding"
                                    Value="0"/>
                            <Setter Property="Background"
                                    Value="Transparent"/>
                            <Setter Property="VerticalContentAlignment"
                                    Value="Top"/>
                            <Setter Property="VerticalAlignment"
                                    Value="Top"/>
                            <Setter Property="Margin"
                                    Value="4,40,4,0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Grid Background="Transparent"
                                              RenderTransformOrigin="0.5, 0.0">
                                            <Grid.RenderTransform>
                                                <ScaleTransform x:Name="ScaleTrans"
                                                                ScaleX="1.0"
                                                                ScaleY="1.0"/>
                                            </Grid.RenderTransform>
                                            <ContentPresenter/>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected"
                                                     Value="True">
                                                <Setter Property="Panel.ZIndex"
                                                        Value="9999"/>
                                                <Trigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="ScaleTrans"
                                                                             Storyboard.TargetProperty="ScaleX"
                                                                             To="1.6"
                                                                             Duration="0:0:0.20"
                                                                             DecelerationRatio="0.6"/>
                                                            <DoubleAnimation Storyboard.TargetName="ScaleTrans"
                                                                             Storyboard.TargetProperty="ScaleY"
                                                                             To="1.6"
                                                                             Duration="0:0:0.20"
                                                                             DecelerationRatio="0.6"/>
                                                            <ThicknessAnimation Storyboard.TargetProperty="Margin"
                                                                                To="45,40,45,0"
                                                                                Duration="0:0:0.20"
                                                                                DecelerationRatio="0.6"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.EnterActions>
                                                <Trigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="ScaleTrans"
                                                                             Storyboard.TargetProperty="ScaleX"
                                                                             To="1.0"
                                                                             Duration="0:0:0.20"
                                                                             DecelerationRatio="0.6"/>
                                                            <DoubleAnimation Storyboard.TargetName="ScaleTrans"
                                                                             Storyboard.TargetProperty="ScaleY"
                                                                             To="1.0"
                                                                             Duration="0:0:0.20"
                                                                             DecelerationRatio="0.6"/>
                                                            <ThicknessAnimation Storyboard.TargetProperty="Margin"
                                                                                To="4,40,4,0"
                                                                                Duration="0:0:0.20"
                                                                                DecelerationRatio="0.6"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.ExitActions>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid VerticalAlignment="Top">
                                <Border x:Name="CardBorder"
                                        Width="150"
                                        Height="150"
                                        CornerRadius="8">
                                    <Border.Background>
                                        <ImageBrush ImageSource="{Binding Cover}"
                                                    Stretch="UniformToFill"/>
                                    </Border.Background>
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="8"
                                                          ShadowDepth="3"
                                                          Opacity="0.4"/>
                                    </Border.Effect>
                                    <Grid x:Name="StoreOverlay"
                                          Visibility="Collapsed">
                                        <StackPanel VerticalAlignment="Center"
                                                    HorizontalAlignment="Center">
                                            <TextBlock Text="⌂"
                                                       FontSize="40"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock Text="LOJA"
                                                       FontSize="14"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Canvas>
                                    <TextBlock x:Name="SideTitle"
                                               Text="{Binding Title}"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"
                                               Width="300"
                                               Canvas.Left="0"
                                               Canvas.Top="100"
                                               Opacity="0"/>
                                </Canvas>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                             Value="True">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="SideTitle"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="1.0"
                                                                 Duration="0:0:0.3"/>
                                                <DoubleAnimation Storyboard.TargetName="SideTitle"
                                                                 Storyboard.TargetProperty="(Canvas.Left)"
                                                                 From="120"
                                                                 To="155"
                                                                 Duration="0:0:0.3"
                                                                 DecelerationRatio="0.5"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="SideTitle"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="0.0"
                                                                 Duration="0:0:0.1"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Source}"
                                             Value="System">
                                    <Setter TargetName="StoreOverlay"
                                            Property="Visibility"
                                            Value="Visible"/>
                                    <Setter TargetName="CardBorder"
                                            Property="Background">
                                        <Setter.Value>
                                            <LinearGradientBrush StartPoint="0,0"
                                                                 EndPoint="1,1">
                                                <GradientStop Color="#FF4758"
                                                              Offset="0"/>
                                                <GradientStop Color="#FF2A2F"
                                                              Offset="1"/>
                                            </LinearGradientBrush>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Border Grid.Row="3"
                    x:Name="SettingsMenu"
                    Visibility="Collapsed"
                    Padding="0"
                    Background="Transparent">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Definições"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontSize="42"
                               FontWeight="Bold"
                               VerticalAlignment="Top"
                               Margin="40,0,0,0"/>

                    <StackPanel x:Name="SettingsCategories"
                                Grid.Column="0"
                                Margin="40,60,0,0">
                        <RadioButton x:Name="BtnTabGeneral"
                                     Content="Geral"
                                     IsChecked="True"
                                     Style="{StaticResource SettingsTabStyle}"
                                     Height="50"
                                     Checked="Tab_Checked"
                                     Click="Category_Click"/>

                        <RadioButton x:Name="BtnTabSystem"
                                     Content="Sistema"
                                     Style="{StaticResource SettingsTabStyle}"
                                     Height="50"
                                     Checked="Tab_Checked"
                                     Click="Category_Click"/>

                        <RadioButton x:Name="BtnTabPersonalization"
                                     Content="Personalização"
                                     Style="{StaticResource SettingsTabStyle}"
                                     Height="50"
                                     Checked="Tab_Checked"
                                     Click="Category_Click"/>
                        <RadioButton x:Name="BtnTabAccount"
                                     Content="Conta"
                                     Style="{StaticResource SettingsTabStyle}"
                                     Height="50"
                                     Checked="Tab_Checked"
                                     Click="Category_Click"/>
                    </StackPanel>

                    <Border Grid.Column="1"
                            Background="#D9101010"
                            CornerRadius="16,0,0,16"
                            Margin="20,0,0,20"
                            Padding="40">
                        <Grid x:Name="SettingsContentArea">

                            <StackPanel x:Name="TabGeneral"
                                        Visibility="Visible">
                                <TextBlock Text="Geral"
                                           Foreground="{DynamicResource AccentBrush}"
                                           FontWeight="Bold"
                                           Margin="0,0,0,20"/>

                                <Grid Margin="0,0,0,30">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="50"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Volume Principal"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   FontSize="18"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="Saída de áudio do sistema"
                                                   Foreground="{DynamicResource textSecondary}"
                                                   FontSize="12"/>
                                    </StackPanel>
                                    <Slider x:Name="VolumeSlider"
                                            Grid.Column="1"
                                            Style="{StaticResource ModernSlider}"
                                            Minimum="0"
                                            Maximum="100"
                                            Value="50"
                                            ValueChanged="VolumeSlider_ValueChanged"
                                            Focusable="True"/>
                                    <TextBlock Text="{Binding ElementName=VolumeSlider, Path=Value, StringFormat={}{0:0}}"
                                               Grid.Column="2"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Right"/>
                                </Grid>

                                <Grid Margin="0,0,0,30">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Contador de FPS"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   FontSize="18"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="Overlay de desempenho em jogo"
                                                   Foreground="{DynamicResource textSecondary}"
                                                   FontSize="12"/>
                                    </StackPanel>
                                    <CheckBox x:Name="ToggleFPS"
                                              Grid.Column="1"
                                              Style="{StaticResource ToggleSwitch}"
                                              Focusable="True"/>
                                </Grid>

                                <TextBlock Text="Armazenamento"
                                           Foreground="{DynamicResource AccentBrush}"
                                           FontWeight="Bold"
                                           Margin="0,0,0,15"/>
                                <Border Background="#22FFFFFF"
                                        CornerRadius="8"
                                        Padding="15">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,10">
                                            <TextBlock Text="Disco Local (C:)"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       FontWeight="SemiBold"/>
                                            <TextBlock x:Name="StorageText"
                                                       Text="Calculando..."
                                                       Foreground="{DynamicResource textSecondary}"
                                                       HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Grid Height="10">
                                            <Border Background="#33000000"
                                                    CornerRadius="5"/>
                                            <ProgressBar x:Name="StorageBar"
                                                         Value="0"
                                                         Maximum="100"
                                                         BorderThickness="0"
                                                         Background="Transparent"
                                                         Foreground="{DynamicResource AccentBrush}"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel x:Name="TabSystem"
                                        Visibility="Collapsed">
                                <TextBlock Text="Rede e Hardware"
                                           Foreground="{DynamicResource AccentBrush}"
                                           FontWeight="Bold"
                                           Margin="0,0,0,20"/>

                                <Grid Margin="0,0,0,30">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Rede Wi-Fi"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   FontSize="18"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock x:Name="WifiStatusText"
                                                   Text="Estado da conexão"
                                                   Foreground="{DynamicResource textSecondary}"
                                                   FontSize="12"/>
                                    </StackPanel>
                                    <Border Grid.Column="1"
                                            CornerRadius="4"
                                            Padding="15,5"
                                            x:Name="BtnWifiBorder">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background"
                                                        Value="#33FFFFFF"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ElementName=BtnWifiReal, Path=IsFocused}"
                                                                 Value="True">
                                                        <Setter Property="Background"
                                                                Value="{DynamicResource AccentBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="Configurar >"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   FontWeight="Bold"/>
                                    </Border>
                                    <Button x:Name="BtnWifiReal"
                                            Click="OpenWifiModal_Click"
                                            Grid.ColumnSpan="2"
                                            Opacity="0"
                                            Focusable="True"/>
                                </Grid>

                                <Border Background="#11FFFFFF"
                                        CornerRadius="8"
                                        Padding="15"
                                        Margin="0,0,0,30">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,10">
                                            <TextBlock Text="Processador (CPU)"
                                                       Foreground="{DynamicResource textSecondary}"/>
                                            <TextBlock x:Name="CpuInfoText"
                                                       Text="A ler..."
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       HorizontalAlignment="Right"
                                                       MaxWidth="350"
                                                       TextTrimming="CharacterEllipsis"
                                                       FontWeight="SemiBold"/>
                                        </Grid>

                                        <Grid Margin="0,0,0,10">
                                            <TextBlock Text="Placa Gráfica (GPU)"
                                                       Foreground="{DynamicResource textSecondary}"/>
                                            <TextBlock x:Name="GpuInfoText"
                                                       Text="A ler..."
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       HorizontalAlignment="Right"
                                                       MaxWidth="350"
                                                       TextTrimming="CharacterEllipsis"
                                                       FontWeight="SemiBold"/>
                                        </Grid>

                                        <Grid Margin="0,0,0,10">
                                            <TextBlock Text="Resolução"
                                                       Foreground="{DynamicResource textSecondary}"/>
                                            <TextBlock x:Name="MonitorInfoText"
                                                       Text="-"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       HorizontalAlignment="Right"/>
                                        </Grid>

                                        <Grid>
                                            <TextBlock Text="Memória RAM"
                                                       Foreground="{DynamicResource textSecondary}"/>
                                            <TextBlock x:Name="RamInfoText"
                                                       Text="-"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       HorizontalAlignment="Right"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="Energia"
                                           Foreground="{DynamicResource AccentBrush}"
                                           FontWeight="Bold"
                                           Margin="0,0,0,15"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Content="Reiniciar"
                                            Height="50"
                                            Click="BtnRestart_Click"
                                            Style="{StaticResource SettingsButtonStyle}"
                                            Grid.Column="0"
                                            Focusable="True"/>
                                    <Button Content="Desligar"
                                            Height="50"
                                            Click="BtnShutdown_Click"
                                            Style="{StaticResource SettingsButtonStyle}"
                                            Grid.Column="2"
                                            Focusable="True">
                                        <Button.Foreground>
                                            <SolidColorBrush Color="#FF4758"/>
                                        </Button.Foreground>
                                    </Button>
                                </Grid>
                            </StackPanel>

                            <StackPanel x:Name="TabPersonalization"
                                        Visibility="Collapsed">
                                <TextBlock Text="Temas Visuais"
                                           Foreground="{DynamicResource AccentBrush}"
                                           FontWeight="Bold"
                                           Margin="0,0,0,20"/>

                                <Button Content="Pichalnovense (Oficial)"
                                        Height="50"
                                        Margin="0,0,0,10"
                                        Click="BtnThemePichal_Click"
                                        Style="{StaticResource SettingsButtonStyle}"
                                        Focusable="True"/>
                                <Button Content="Pichal Red (Clássico)"
                                        Height="50"
                                        Margin="0,0,0,10"
                                        Click="BtnThemeRed_Click"
                                        Style="{StaticResource SettingsButtonStyle}"
                                        Focusable="True"/>
                                <Button Content="Deep Blue"
                                        Height="50"
                                        Margin="0,0,0,10"
                                        Click="BtnThemeBlue_Click"
                                        Style="{StaticResource SettingsButtonStyle}"
                                        Focusable="True"/>
                                <Button Content="OLED Black"
                                        Height="50"
                                        Margin="0,0,0,10"
                                        Click="BtnThemeDark_Click"
                                        Style="{StaticResource SettingsButtonStyle}"
                                        Focusable="True"/>
                                <Button Content="Editar Tema"
                                        Height="50"
                                        Margin="0,0,0,10"
                                        Click="OpenThemeCreator_Click"
                                        Style="{StaticResource SettingsButtonStyle}"
                                        Focusable="True"/>
                            </StackPanel>

                            <StackPanel x:Name="TabAccount"
                                        Visibility="Collapsed">
                                <TextBlock Text="A Minha Conta"
                                           Foreground="{DynamicResource AccentBrush}"
                                           FontWeight="Bold"
                                           Margin="0,0,0,20"/>

                                <Border Background="#22FFFFFF"
                                        CornerRadius="12"
                                        Padding="20"
                                        Margin="0,0,0,30">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Center"
                                                    Margin="0,0,0,20">
                                            <Image Source="{Binding ElementName=ProfileImage, Path=Source}"
                                                   Width="60"
                                                   Height="60"
                                                   Margin="0,0,15,0">
                                                <Image.Clip>
                                                    <EllipseGeometry Center="30,30"
                                                                     RadiusX="30"
                                                                     RadiusY="30"/>
                                                </Image.Clip>
                                            </Image>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ElementName=ProfileName, Path=Text}"
                                                           FontSize="24"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <TextBlock Text="Sessão Iniciada"
                                                           Foreground="{DynamicResource AccentBrush}"
                                                           FontSize="12"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <Button x:Name="BtnRelogin"
                                                Content="Trocar Conta / Refresh"
                                                Height="45"
                                                Style="{StaticResource SettingsButtonStyle}"
                                                Click="BtnConnectSteam_Click"
                                                Focusable="True"/>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="Integrações"
                                           Foreground="{DynamicResource textSecondary}"
                                           Margin="0,0,0,10"/>
                                <Button Content="Associar Spotify (Em Breve)"
                                        Height="45"
                                        IsEnabled="False"
                                        Opacity="0.5"
                                        Style="{StaticResource SettingsButtonStyle}"
                                        Margin="0,0,0,10"/>
                                <Button Content="Associar Discord (Em Breve)"
                                        Height="45"
                                        IsEnabled="False"
                                        Opacity="0.5"
                                        Style="{StaticResource SettingsButtonStyle}"/>
                            </StackPanel>

                        </Grid>
                    </Border>

                    <Grid x:Name="WifiSelectorModal"
                          Grid.ColumnSpan="2"
                          Background="#F2000000"
                          Visibility="Collapsed">
                        <Border Width="500"
                                Height="Auto"
                                VerticalAlignment="Center"
                                Background="#1A1A1A"
                                CornerRadius="12"
                                BorderBrush="#333"
                                BorderThickness="1">
                            <Grid Margin="30">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="Redes Wi-Fi"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           FontSize="28"
                                           FontWeight="Bold"
                                           Margin="0,0,0,20"/>

                                <ListBox x:Name="WifiListBox"
                                         Grid.Row="1"
                                         Height="300"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         SelectionChanged="WifiListBox_SelectionChanged">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding"
                                                    Value="10"/>
                                            <Setter Property="Margin"
                                                    Value="0,0,0,5"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="Bd"
                                                                Background="#22FFFFFF"
                                                                CornerRadius="6"
                                                                Padding="15">
                                                            <Grid>
                                                                <TextBlock Text="{Binding SSID}"
                                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                                           FontWeight="Bold"
                                                                           FontSize="16"/>
                                                                <TextBlock Text="{Binding SignalStrength}"
                                                                           Foreground="{DynamicResource textSecondary}"
                                                                           HorizontalAlignment="Right"/>
                                                            </Grid>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsSelected"
                                                                     Value="True">
                                                                <Setter TargetName="Bd"
                                                                        Property="Background"
                                                                        Value="{DynamicResource AccentBrush}"/>
                                                                <Setter Property="Foreground"
                                                                        Value="Black"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>

                                <StackPanel x:Name="WifiPasswordPanel"
                                            Grid.Row="2"
                                            Visibility="Collapsed"
                                            Margin="0,20,0,0">
                                    <TextBlock Text="Password da Rede:"
                                               Foreground="{DynamicResource textSecondary}"
                                               Margin="0,0,0,5"/>
                                    <PasswordBox x:Name="WifiPasswordBox"
                                                 Height="40"
                                                 FontSize="16"
                                                 Background="#333"
                                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                                 BorderThickness="0"
                                                 Padding="10,5"
                                                 VerticalContentAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Grid.Row="3"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            Margin="0,30,0,0">
                                    <Button Content="Cancelar"
                                            Click="CloseWifiModal_Click"
                                            Width="100"
                                            Height="40"
                                            Background="Transparent"
                                            Foreground="{DynamicResource TextPrimaryBrush}"
                                            Margin="0,0,10,0"/>

                                    <Button x:Name="BtnConnectWifi"
                                            Content="Ligar"
                                            Click="ConnectWifi_Click"
                                            Width="120"
                                            Height="40"
                                            Background="{DynamicResource AccentBrush}"
                                            Foreground="Black"
                                            FontWeight="Bold">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius"
                                                        Value="6"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>


            <Border Grid.Row="3"
                    x:Name="FriendMenu"
                    Visibility="Collapsed"
                    x:FieldModifier="public">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                    </Grid.ColumnDefinitions>

                    <ListBox x:Name="FriendListBox"
                             x:FieldModifier="public"
                             SelectionChanged="FriendListBox_SelectionChanged"
                             Width="Auto"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.VerticalScrollBarVisibility="Hidden"
                             VirtualizingStackPanel.IsVirtualizing="True"
                             VirtualizingStackPanel.VirtualizationMode="Recycling"
                             KeyboardNavigation.TabNavigation="Local"
                             SelectionMode="Single"
                             Grid.Column="1"
                             HorizontalAlignment="Left"
                             Padding="0"
                             Margin="3">

                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="FocusVisualStyle"
                                        Value="{x:Null}"/>
                                <Setter Property="Foreground"
                                        Value="White"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd"
                                                    Background="Transparent"
                                                    Padding="2"
                                                    CornerRadius="5"
                                                    SnapsToDevicePixels="True">
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected"
                                                         Value="True">
                                                    <Setter TargetName="Bd"
                                                            Property="Background"
                                                            Value="{DynamicResource AccentBrush}"/>
                                                    <Setter Property="FontWeight"
                                                            Value="Bold"/>
                                                    <Setter Property="Foreground"
                                                            Value="Black"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver"
                                                         Value="True">
                                                    <Setter TargetName="Bd"
                                                            Property="Background"
                                                            Value="#33FFFFFF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8"
                                        CornerRadius="4"
                                        Width="400"
                                        Background="{DynamicResource PanelBackgroundBrush}">
                                    <DockPanel>
                                        <Grid Width="40"
                                              Height="40"
                                              Margin="0,0,12,0"
                                              VerticalAlignment="Center">
                                            <Image Source="{Binding AvatarFull}"
                                                   Stretch="UniformToFill">
                                                <Image.Clip>
                                                    <RectangleGeometry Rect="0,0,40,40"
                                                                       RadiusX="4"
                                                                       RadiusY="4"/>
                                                </Image.Clip>
                                            </Image>
                                            <Ellipse Width="10"
                                                     Height="10"
                                                     HorizontalAlignment="Right"
                                                     VerticalAlignment="Bottom"
                                                     Fill="{Binding StatusColor}"
                                                     Stroke="{DynamicResource PanelBackgroundBrush}"
                                                     StrokeThickness="1"/>
                                        </Grid>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding PersonaName}"
                                                       FontSize="14"/>
                                            <TextBlock Text="{Binding StatusText}"
                                                       FontSize="11"
                                                       Opacity="0.7"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Grid.Column="2"
                            Background="#FF0E0E0E"
                            CornerRadius="12"
                            Margin="10,3,3,3"
                            ClipToBounds="True">
                        <Grid>
                            <TextBlock Text="Seleciona um amigo"
                                       Foreground="{DynamicResource textSecondary}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="16">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility"
                                                Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ElementName=FriendListBox, Path=SelectedIndex}"
                                                         Value="-1">
                                                <Setter Property="Visibility"
                                                        Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <Grid DataContext="{Binding ElementName=FriendListBox, Path=SelectedItem}">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility"
                                                Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ElementName=FriendListBox, Path=SelectedIndex}"
                                                         Value="-1">
                                                <Setter Property="Visibility"
                                                        Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>

                                <ScrollViewer VerticalScrollBarVisibility="Hidden"
                                              Margin="40">
                                    <StackPanel>

                                        <StackPanel Orientation="Horizontal"
                                                    Margin="0,0,0,40">

                                            <Grid Margin="0,0,25,0">
                                                <Border CornerRadius="60"
                                                        Width="120"
                                                        Height="120">
                                                    <Border.Effect>
                                                        <DropShadowEffect Color="Black"
                                                                          BlurRadius="20"
                                                                          Opacity="0.5"/>
                                                    </Border.Effect>
                                                    <Image Source="{Binding AvatarFull}"
                                                           Stretch="UniformToFill">
                                                        <Image.Clip>
                                                            <EllipseGeometry Center="60,60"
                                                                             RadiusX="60"
                                                                             RadiusY="60"/>
                                                        </Image.Clip>
                                                    </Image>
                                                </Border>

                                                <Border Background="#111"
                                                        BorderBrush="{DynamicResource AccentBrush}"
                                                        BorderThickness="2"
                                                        CornerRadius="20"
                                                        Width="40"
                                                        Height="40"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Bottom">
                                                    <TextBlock Text="{Binding SteamLevel}"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                               FontWeight="Bold"
                                                               FontSize="14"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>

                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding PersonaName}"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           FontSize="42"
                                                           FontWeight="Bold"/>

                                                <StackPanel Orientation="Horizontal"
                                                            Margin="0,5,0,0">
                                                    <Border Background="{Binding StatusColor}"
                                                            CornerRadius="4"
                                                            Padding="8,4"
                                                            Margin="0,0,10,0">
                                                        <TextBlock Text="{Binding StatusText}"
                                                                   Foreground="Black"
                                                                   FontWeight="Bold"
                                                                   FontSize="12"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding MutualFriendsText}"
                                                               Foreground="{DynamicResource textSecondary}"
                                                               FontSize="14"
                                                               VerticalAlignment="Center"
                                                               FontStyle="Italic"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Visibility="{Binding GameCoverVisibility}"
                                                    Margin="0,0,0,30">
                                            <TextBlock Text="A JOGAR AGORA"
                                                       Foreground="{DynamicResource textSecondary}"
                                                       FontSize="12"
                                                       FontWeight="Bold"
                                                       Margin="0,0,0,10"/>
                                            <Border Background="#22FFFFFF"
                                                    CornerRadius="8"
                                                    Padding="20">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Image Source="{Binding GameCoverUrl}"
                                                           Width="120"
                                                           Height="60"
                                                           Stretch="UniformToFill"
                                                           Margin="0,0,20,0">
                                                        <Image.Clip>
                                                            <RectangleGeometry Rect="0,0,120,60"
                                                                               RadiusX="4"
                                                                               RadiusY="4"/>
                                                        </Image.Clip>
                                                    </Image>

                                                    <StackPanel Grid.Column="1"
                                                                VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding GameExtraInfo}"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                                   FontSize="24"
                                                                   FontWeight="Bold"/>
                                                        <TextBlock Text="{Binding RichPresence}"
                                                                   Foreground="{DynamicResource AccentBrush}"
                                                                   FontSize="14"
                                                                   Margin="0,5,0,0"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </StackPanel>

                                        <StackPanel Margin="0,0,0,30">
                                            <TextBlock Text="ATIVIDADE RECENTE"
                                                       Foreground="{DynamicResource textSecondary}"
                                                       FontSize="12"
                                                       FontWeight="Bold"
                                                       Margin="0,0,0,10"/>

                                            <ListBox ItemsSource="{Binding RecentGames}"
                                                     Background="Transparent"
                                                     BorderThickness="0"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                                <ListBox.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ListBox.ItemsPanel>
                                                <ListBox.ItemContainerStyle>
                                                    <Style TargetType="ListBoxItem">
                                                        <Setter Property="FocusVisualStyle"
                                                                Value="{x:Null}"/>
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="ListBoxItem">
                                                                    <ContentPresenter/>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </ListBox.ItemContainerStyle>
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Margin="0,0,15,0"
                                                                    Width="110">
                                                            <Border CornerRadius="6"
                                                                    Height="160"
                                                                    Background="#222"
                                                                    ClipToBounds="True">
                                                                <Image Source="{Binding CoverUrl}"
                                                                       Width="110"
                                                                       Height="160"
                                                                       Stretch="UniformToFill"/>
                                                            </Border>
                                                            <TextBlock Text="{Binding Name}"
                                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                                       FontSize="12"
                                                                       FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Margin="0,8,0,0"/>
                                                            <TextBlock Text="{Binding Playtime2Weeks}"
                                                                       Foreground="{DynamicResource textSecondary}"
                                                                       FontSize="11"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Convidar"
                                                    Height="50"
                                                    Width="160"
                                                    Margin="0,0,15,0"
                                                    Style="{StaticResource SettingsButtonStyle}"
                                                    Focusable="True"
                                                    Command="{Binding DataContext.InviteFriendCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding SteamId}"/>

                                            <Button Content="Ver Perfil Completo"
                                                    Height="50"
                                                    Width="200"
                                                    Background="{DynamicResource AccentBrush}"
                                                    Foreground="Black"
                                                    FontWeight="Bold"
                                                    FontSize="16"
                                                    BorderThickness="0"
                                                    Focusable="True"
                                                    Command="{Binding DataContext.OpenFriendProfileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding ProfileUrl}">
                                                <Button.Resources>
                                                    <Style TargetType="Border">
                                                        <Setter Property="CornerRadius"
                                                                Value="8"/>
                                                    </Style>
                                                </Button.Resources>
                                            </Button>
                                        </StackPanel>

                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Row="3"
                    x:Name="InfoArea"
                    Background="Transparent"
                    Padding="0"
                    Visibility="Collapsed"
                    RenderTransformOrigin="0.5,0.5"
                    Opacity="0"
                    CornerRadius="5"
                    x:FieldModifier="public">

                <Border.RenderTransform>
                    <TranslateTransform x:Name="InfoSlideTransform"
                                        Y="200"/>
                </Border.RenderTransform>

                <Grid>
                    <Border>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0"
                                                 EndPoint="1,0">
                                <GradientStop Color="#EE0E0E0E"
                                              Offset="0.0"/>
                                <GradientStop Color="#CC0E0E0E"
                                              Offset="0.4"/>
                                <GradientStop Color="#990E0E0E"
                                              Offset="1.0"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <Grid Margin="60,40,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="450"/>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="400"/>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    VerticalAlignment="Top">
                            <TextBlock x:Name="HeroTitle"
                                       Text="Nome do Jogo"
                                       FontSize="56"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,15"
                                       LineHeight="60">
                                <TextBlock.Effect>
                                    <DropShadowEffect BlurRadius="20"
                                                      ShadowDepth="4"
                                                      Opacity="0.8"/>
                                </TextBlock.Effect>
                            </TextBlock>

                            <StackPanel Orientation="Horizontal"
                                        Margin="0,0,0,50">
                                <Border Background="{DynamicResource AccentBrush}"
                                        CornerRadius="4"
                                        Padding="10,4"
                                        Margin="0,0,15,0">
                                    <TextBlock x:Name="Info_OwnedOn"
                                               Text="STEAM"
                                               Foreground="Black"
                                               FontWeight="Bold"
                                               FontSize="14"/>
                                </Border>
                                <TextBlock x:Name="Info_Playtime"
                                           Text="120 hrs"
                                           Foreground="LightGray"
                                           VerticalAlignment="Center"
                                           FontSize="16"/>
                                <TextBlock Text=" • "
                                           Foreground="{DynamicResource textSecondary}"
                                           VerticalAlignment="Center"
                                           Margin="10,0"
                                           FontSize="16"/>
                                <TextBlock x:Name="Info_LastPlayed"
                                           Text="Jogado há 2 dias"
                                           Foreground="LightGray"
                                           VerticalAlignment="Center"
                                           FontSize="16"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal"
                                        Margin="0,0,0,40">
                                <Button x:Name="StartBtn"
                                        x:FieldModifier="public"
                                        Content="JOGAR"
                                        Height="70"
                                        Width="260"
                                        Style="{StaticResource PlayButtonStyle}"
                                        Focusable="True"
                                        FontSize="24"
                                        Margin="0,0,20,0"/>

                                <Button x:Name="OptionsBtn"
                                        x:FieldModifier="public"
                                        Content="..."
                                        Height="70"
                                        Width="70"
                                        Click="OpenGameOptions_Click"
                                        Style="{StaticResource SettingsButtonStyle}"
                                        Background="#33FFFFFF"
                                        Foreground="{DynamicResource TextPrimaryBrush}"
                                        FontSize="32"
                                        FontWeight="Bold"
                                        Focusable="True">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius"
                                                    Value="12"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal">
                                <Grid VerticalAlignment="Center">
                                    <ProgressBar x:Name="Info_CompletionBar"
                                                 Value="0"
                                                 Minimum="0"
                                                 Maximum="100"
                                                 Width="300"
                                                 Height="10"
                                                 Background="#33FFFFFF"
                                                 Foreground="{DynamicResource AccentBrush}"
                                                 BorderThickness="0"/>
                                </Grid>
                                <TextBlock x:Name="Info_CompletionPercent"
                                           Text="45%"
                                           Tag="45"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           FontWeight="Bold"
                                           Margin="20,0,0,0"
                                           FontSize="24"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <ScrollViewer VerticalScrollBarVisibility="Hidden"
                                          Height="600">
                                <StackPanel>
                                    <StackPanel x:Name="PanelPlayingNow"
                                                x:FieldModifier="public"
                                                Orientation="Horizontal">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility"
                                                        Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Items.Count, ElementName=GameFriendsList}"
                                                                 Value="0">
                                                        <Setter Property="Visibility"
                                                                Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>

                                        <TextBlock Text="A JOGAR AGORA"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   FontWeight="Bold"
                                                   FontSize="16"
                                                   Margin="0,0,0,15"/>
                                        <ListBox x:Name="GameFriendsList"
                                                 x:FieldModifier="public"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 ItemContainerStyle="{StaticResource FocusableItemStyle}"
                                                 Margin="0,0,0,0"
                                                 Focusable="True">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,0"
                                                          ToolTip="{Binding PersonaName}">
                                                        <Border CornerRadius="20"
                                                                Width="40"
                                                                Height="40">
                                                            <Border.Background>
                                                                <ImageBrush ImageSource="{Binding AvatarFull}"
                                                                            Stretch="UniformToFill"/>
                                                            </Border.Background>
                                                        </Border>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>

                                            <ListBox.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ListBox.ItemsPanel>
                                        </ListBox>
                                    </StackPanel>

                                    <TextBlock Text="AMIGOS QUE TÊM O JOGO"
                                               Foreground="{DynamicResource AccentBrush}"
                                               FontWeight="Bold"
                                               FontSize="16"
                                               Margin="0,0,0,15"/>
                                    <ListBox x:Name="OwnersFriendsList"
                                             x:FieldModifier="public"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ItemContainerStyle="{StaticResource FocusableItemStyle}"
                                             Margin="0,0,0,0"
                                             Focusable="True"
                                             Height="150">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,0"
                                                      ToolTip="{Binding PersonaName}">
                                                    <Border CornerRadius="20"
                                                            Width="40"
                                                            Height="40">
                                                        <Border.Background>
                                                            <ImageBrush ImageSource="{Binding AvatarFull}"
                                                                        Stretch="UniformToFill"/>
                                                        </Border.Background>
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>

                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                    </ListBox>

                                    <TextBlock Text="CONQUISTAS"
                                               Foreground="{DynamicResource AccentBrush}"
                                               FontWeight="Bold"
                                               FontSize="16"
                                               Margin="0,0,0,15"/>
                                    <ListBox x:Name="Info_AchievementsList"
                                             x:FieldModifier="public"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                             ItemContainerStyle="{StaticResource FocusableItemStyle}"
                                             Margin="0,0,0,40"
                                             Focusable="True"
                                             MinHeight="40"
                                             MaxHeight="296"
                                             Foreground="{DynamicResource TextPrimaryBrush}">

                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal"
                                                            Margin="0,0,0,0"
                                                            VerticalAlignment="Center">
                                                    <Image Source="{Binding IconUrl}"
                                                           Width="45"
                                                           Height="45"
                                                           Margin="0,0,10,0"/>

                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DisplayName}"
                                                                   FontWeight="Bold"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                                   FontSize="14"/>
                                                        <TextBlock Text="{Binding Description}"
                                                                   Foreground="{DynamicResource textSecondary}"
                                                                   FontSize="11"
                                                                   TextWrapping="Wrap"
                                                                   MaxWidth="300"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </ScrollViewer>
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <ScrollViewer VerticalScrollBarVisibility="Hidden"
                                          Height="600">
                                <StackPanel>
                                    <TextBlock Text="ÚLTIMAS NOVIDADES"
                                               Foreground="{DynamicResource AccentBrush}"
                                               FontWeight="Bold"
                                               FontSize="16"
                                               Margin="0,0,0,0"/>
                                    <ListBox x:Name="Info_NewsList"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                                             ItemContainerStyle="{StaticResource FocusableItemStyle}"
                                             Focusable="True"
                                             MaxHeight="500">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#22FFFFFF"
                                                        CornerRadius="8"
                                                        Padding="20"
                                                        Margin="0,0,0,0"
                                                        HorizontalAlignment="Stretch">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Title}"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                                   FontWeight="Bold"
                                                                   FontSize="16"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   MaxWidth="400"
                                                                   TextAlignment="Left"/>
                                                        <TextBlock Text="{Binding Date}"
                                                                   Foreground="{DynamicResource textSecondary}"
                                                                   FontSize="12"
                                                                   Margin="0,5,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <TextBlock Text="GALERIA"
                                               Foreground="{DynamicResource AccentBrush}"
                                               FontWeight="Bold"
                                               FontSize="16"
                                               Margin="0,20,0,15"/>
                                    <ListBox x:Name="Info_Screenshots"
                                             x:FieldModifier="public"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                             ItemContainerStyle="{StaticResource FocusableItemStyle}"
                                             Margin="0,0,0,0"
                                             Focusable="True">
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="6"
                                                        Width="160"
                                                        Height="90"
                                                        Margin="0,0,0,0"
                                                        Background="#222">
                                                    <Image Source="{Binding}"
                                                           Stretch="UniformToFill"/>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                </StackPanel>
                            </ScrollViewer>
                        </StackPanel>

                    </Grid>
                    <Grid x:Name="NewsReaderModal"
                          Background="#E6000000"
                          Visibility="Collapsed"
                          x:FieldModifier="public">
                        <Border Background="#1A1A1A"
                                BorderBrush="{DynamicResource AccentBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                MaxWidth="800"
                                MaxHeight="600"
                                Margin="50"
                                Padding="20">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="NewsModalTitle"
                                           Text="Título da Notícia"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           FontSize="28"
                                           FontWeight="Bold"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,10"/>
                                <TextBlock x:Name="NewsModalDate"
                                           Text="Data"
                                           Foreground="{DynamicResource textSecondary}"
                                           FontSize="14"
                                           Margin="0,0,0,20"
                                           Grid.Row="1"/>
                                <ScrollViewer Grid.Row="2"
                                              Margin="0,0,0,20">
                                    <TextBlock x:Name="NewsModalContent"
                                               Text="Conteúdo..."
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               FontSize="16"
                                               TextWrapping="Wrap"
                                               LineHeight="24"/>
                                </ScrollViewer>
                                <Button Grid.Row="3"
                                        Content="Fechar (ESC)"
                                        Click="CloseNewsModal_Click"
                                        Height="40"
                                        Width="150"
                                        HorizontalAlignment="Right"
                                        Style="{StaticResource SettingsButtonStyle}"
                                        Background="{DynamicResource AccentBrush}"
                                        Foreground="Black"
                                        FontWeight="Bold"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid x:Name="GameOptionsModal"
                          Background="#CC000000"
                          Visibility="Collapsed"
                          x:FieldModifier="public">
                        <Border Background="#1A1A1A"
                                BorderBrush="{DynamicResource AccentBrush}"
                                BorderThickness="2"
                                CornerRadius="12"
                                Width="400"
                                VerticalAlignment="Center"
                                Padding="20">
                            <StackPanel>
                                <TextBlock Text="Opções"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,20"/>
                                <Button Content="Adicionar aos Favoritos"
                                        Height="50"
                                        Margin="0,0,0,10"
                                        Style="{StaticResource SettingsButtonStyle}"
                                        Click="OptionFavorite_Click"
                                        Focusable="True"/>
                                <Button Content="Criar Atalho"
                                        Height="50"
                                        Margin="0,0,0,10"
                                        Style="{StaticResource SettingsButtonStyle}"
                                        Click="OptionShortcut_Click"
                                        Focusable="True"/>
                                <Button Content="Desinstalar"
                                        Height="50"
                                        Margin="0,20,0,10"
                                        Background="#33FF0000"
                                        Foreground="Red"
                                        FontWeight="Bold"
                                        Style="{StaticResource SettingsButtonStyle}"
                                        Click="OptionUninstall_Click"
                                        Focusable="True"/>
                                <Button Content="Voltar"
                                        Height="50"
                                        Margin="0,10,0,0"
                                        Style="{StaticResource SettingsButtonStyle}"
                                        Click="CloseGameOptions_Click"
                                        Focusable="True"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <Grid x:Name="ChristmasOverlay"
                  Grid.RowSpan="10"
                  Panel.ZIndex="5000"
                  IsHitTestVisible="False"
                  Visibility="Collapsed">

                <Canvas x:Name="SnowCanvas">
                    <Canvas.RenderTransform>
                        <TranslateTransform x:Name="SnowWindTransform"/>
                    </Canvas.RenderTransform>
                </Canvas>

                <Border x:Name="SnowFloor"
                        VerticalAlignment="Bottom"
                        Height="80"
                        Opacity="0"
                        Margin="0,0,0,-20">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0"
                                             EndPoint="0,1">
                            <GradientStop Color="#00FFFFFF"
                                          Offset="0"/>
                            <GradientStop Color="#40FFFFFF"
                                          Offset="0.4"/>
                            <GradientStop Color="#CCF0F8FF"
                                          Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Effect>
                        <BlurEffect Radius="20"/>
                    </Border.Effect>
                </Border>

                <Canvas x:Name="FrostGolem"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Width="200"
                        Height="300"
                        Margin="0,0,50,0"
                        Opacity="0">

                    <Canvas.RenderTransform>
                        <TransformGroup>
                            <TranslateTransform x:Name="GolemWindSlide"
                                                X="0"/>
                            <ScaleTransform x:Name="GolemScale"
                                            ScaleX="1"
                                            ScaleY="1"/>
                        </TransformGroup>
                    </Canvas.RenderTransform>

                    <Ellipse Width="120"
                             Height="20"
                             Canvas.Left="40"
                             Canvas.Top="280"
                             Opacity="0.5">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#8000FFFF"
                                              Offset="0"/>
                                <GradientStop Color="Transparent"
                                              Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                        <Ellipse.Effect>
                            <BlurEffect Radius="10"/>
                        </Ellipse.Effect>
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever"
                                                AutoReverse="True">
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         From="0.2"
                                                         To="0.6"
                                                         Duration="0:0:2"/>
                                        <DoubleAnimation Storyboard.TargetProperty="Width"
                                                         From="100"
                                                         To="130"
                                                         Duration="0:0:2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>

                    <Path x:Name="GolemBody"
                          Data="M 20,0 L 80,-10 L 100,50 L 0,40 Z"
                          Fill="#D0E0FF"
                          Canvas.Left="50"
                          Canvas.Top="180">
                        <Path.Effect>
                            <DropShadowEffect Color="#00A0FF"
                                              BlurRadius="15"
                                              ShadowDepth="0"
                                              Opacity="0.4"/>
                        </Path.Effect>
                        <Path.RenderTransform>
                            <TranslateTransform x:Name="BodyFloat"
                                                Y="0"/>
                        </Path.RenderTransform>
                    </Path>

                    <Path x:Name="GolemChest"
                          Data="M 10,0 L 90,10 L 70,60 L 30,50 Z"
                          Fill="#F0FFFF"
                          Canvas.Left="55"
                          Canvas.Top="130">
                        <Path.Effect>
                            <DropShadowEffect Color="White"
                                              BlurRadius="5"
                                              ShadowDepth="0"/>
                        </Path.Effect>
                        <Path.RenderTransform>
                            <TranslateTransform x:Name="ChestFloat"
                                                Y="0"/>
                        </Path.RenderTransform>
                    </Path>

                    <Grid x:Name="GolemHead"
                          Canvas.Left="70"
                          Canvas.Top="70"
                          Width="60"
                          Height="70">
                        <Grid.RenderTransform>
                            <TranslateTransform x:Name="HeadFloat"
                                                Y="0"/>
                        </Grid.RenderTransform>

                        <Path Data="M 0,20 L 30,0 L 60,20 L 50,60 L 10,60 Z"
                              Fill="#E0F0FF">
                            <Path.Effect>
                                <DropShadowEffect Color="#00FFFF"
                                                  BlurRadius="10"
                                                  ShadowDepth="0"
                                                  Opacity="0.5"/>
                            </Path.Effect>
                        </Path>

                        <Rectangle Width="15"
                                   Height="4"
                                   Fill="#00FFFF"
                                   VerticalAlignment="Top"
                                   HorizontalAlignment="Left"
                                   Margin="12,25,0,0">
                            <Rectangle.Effect>
                                <DropShadowEffect Color="#00FFFF"
                                                  BlurRadius="5"
                                                  ShadowDepth="0"/>
                            </Rectangle.Effect>
                        </Rectangle>
                        <Rectangle Width="15"
                                   Height="4"
                                   Fill="#00FFFF"
                                   VerticalAlignment="Top"
                                   HorizontalAlignment="Right"
                                   Margin="0,25,12,0">
                            <Rectangle.Effect>
                                <DropShadowEffect Color="#00FFFF"
                                                  BlurRadius="5"
                                                  ShadowDepth="0"/>
                            </Rectangle.Effect>
                        </Rectangle>
                    </Grid>

                    <Ellipse Width="4"
                             Height="4"
                             Fill="White"
                             Canvas.Left="40"
                             Canvas.Top="100"
                             x:Name="MagicParticle1"
                             Opacity="0"/>
                    <Ellipse Width="3"
                             Height="3"
                             Fill="Cyan"
                             Canvas.Left="160"
                             Canvas.Top="200"
                             x:Name="MagicParticle2"
                             Opacity="0"/>

                </Canvas>
            </Grid>
            <Border Grid.Row="4"
                    Height="30"
                    Background="#06080C"
                    Padding="10,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusLabel"
                               Text="Ready"
                               Foreground="Gray"
                               VerticalAlignment="Center"/>
                    <Button x:Name="BtnConnectSteam"
                            Content="Connect Steam"
                            Grid.Column="1"
                            Width="100"
                            Height="20"
                            Margin="10,0"/>
                    <TextBlock Text="v0.4.11 - alpha"
                               Foreground="Gray"
                               Grid.Column="2"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
        <Grid x:Name="LoadingOverlay"
              Grid.RowSpan="5"
              Background="#D9000000"
              Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center">
                <TextBlock x:Name="LoadingText"
                           Text="A carregar..."
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           FontSize="24"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"/>
                <ProgressBar IsIndeterminate="True"
                             Width="200"
                             Height="4"
                             BorderThickness="0"
                             Background="#33FFFFFF"
                             Foreground="#FFCC00"/>
            </StackPanel>
        </Grid>

        <Grid x:Name="ChatModal"
              Visibility="Collapsed"
              Background="#CC000000"
              x:FieldModifier="public">
            <Border Height="600"
                    Width="500"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="0,0,50,0"
                    Background="#1F1F1F"
                    CornerRadius="12"
                    BorderBrush="{DynamicResource AccentBrush}"
                    BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30"
                                      ShadowDepth="0"
                                      Opacity="0.5"/>
                </Border.Effect>

                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0"
                               Margin="0,0,0,15">
                        <Button Content="X"
                                Click="CloseChat_Click"
                                DockPanel.Dock="Right"
                                Style="{StaticResource SettingsButtonStyle}"
                                Width="40"
                                HorizontalContentAlignment="Center"/>
                        <Image x:Name="ChatFriendAvatar"
                               Width="30"
                               Height="30"
                               Margin="0,0,10,0">
                            <Image.Clip>
                                <EllipseGeometry Center="15,15"
                                                 RadiusX="15"
                                                 RadiusY="15"/>
                            </Image.Clip>
                        </Image>
                        <TextBlock x:Name="ChatFriendName"
                                   Text="Nome do Amigo"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                    </DockPanel>

                    <ListBox x:Name="ChatList"
                             Grid.Row="1"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             Margin="0,0,0,15">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="FocusVisualStyle"
                                        Value="{x:Null}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,5">
                                    <Border Background="{Binding BubbleColor}"
                                            CornerRadius="8"
                                            Padding="10,8"
                                            HorizontalAlignment="{Binding Alignment}"
                                            MaxWidth="350">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Message}"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       TextWrapping="Wrap"
                                                       FontSize="14"/>
                                            <TextBlock Text="{Binding Time}"
                                                       Foreground="#AAFFFFFF"
                                                       FontSize="10"
                                                       HorizontalAlignment="Right"
                                                       Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ChatInputBox"
                                 Height="40"
                                 Background="#333"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 BorderThickness="0"
                                 VerticalContentAlignment="Center"
                                 Padding="10,0"
                                 KeyDown="ChatInputBox_KeyDown"
                                 FontSize="14"/>
                        <Button Grid.Column="1"
                                Content="Enviar"
                                Click="SendChat_Click"
                                Style="{StaticResource SettingsButtonStyle}"
                                Background="{DynamicResource AccentBrush}"
                                Foreground="Black"
                                FontWeight="Bold"
                                Width="80"
                                Margin="10,0,0,0"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Border x:Name="NotificationPopup"
                VerticalAlignment="Top"
                HorizontalAlignment="Center"
                Margin="0,-100,0,0"
                Background="#1A1A1A"
                BorderBrush="{DynamicResource AccentBrush}"
                BorderThickness="1"
                CornerRadius="30"
                Padding="20,10"
                Height="60"
                x:FieldModifier="public"
                Panel.ZIndex="9999">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20"
                                  ShadowDepth="4"
                                  Opacity="0.6"/>
            </Border.Effect>

            <StackPanel Orientation="Horizontal">
                <Grid Width="40"
                      Height="40"
                      Margin="0,0,15,0">
                    <Image x:Name="NotifImage"
                           Stretch="UniformToFill">
                        <Image.Clip>
                            <EllipseGeometry Center="20,20"
                                             RadiusX="20"
                                             RadiusY="20"/>
                        </Image.Clip>
                    </Image>
                </Grid>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="NotifTitle"
                               Text="Nome"
                               Foreground="{DynamicResource AccentBrush}"
                               FontWeight="Bold"
                               FontSize="14"/>
                    <TextBlock x:Name="NotifMessage"
                               Text="Mensagem Recebida"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontSize="12"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="300"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid x:Name="StartupOverlay"
              Grid.RowSpan="5"
              Visibility="Visible"
              Panel.ZIndex="99999"
              x:FieldModifier="public">

            <Grid.Background>
                <RadialGradientBrush x:Name="IntroBackgroundGradient"
                                     GradientOrigin="0.5,0.5"
                                     Center="0.5,0.5"
                                     RadiusX="0.0"
                                     RadiusY="0.0">
                    <GradientStop x:Name="IntroColorCore"
                                  Color="#FFD700"
                                  Offset="0.0"/>
                    <GradientStop x:Name="IntroColorEdge"
                                  Color="#003300"
                                  Offset="1.0"/>
                </RadialGradientBrush>
            </Grid.Background>

            <Grid HorizontalAlignment="Center"
                  VerticalAlignment="Center">

                <Ellipse x:Name="IntroShockwave1"
                         Width="50"
                         Height="50"
                         Stroke="#FFD700"
                         StrokeThickness="5"
                         Opacity="0"
                         RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <ScaleTransform x:Name="ShockScale1"
                                        ScaleX="1"
                                        ScaleY="1"/>
                    </Ellipse.RenderTransform>
                </Ellipse>

                <Ellipse x:Name="IntroShockwave2"
                         Width="50"
                         Height="50"
                         Stroke="White"
                         StrokeThickness="2"
                         Opacity="0"
                         RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <ScaleTransform x:Name="ShockScale2"
                                        ScaleX="1"
                                        ScaleY="1"/>
                    </Ellipse.RenderTransform>
                </Ellipse>

                <Image x:Name="IntroLogo"
                       Source="Assets/PichalLeaf.png"
                       Width="280"
                       Height="280"
                       RenderTransformOrigin="0.5,0.5"
                       Opacity="0">
                    <Image.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="IntroLogoScale"
                                            ScaleX="0.0"
                                            ScaleY="0.0"/>
                            <RotateTransform x:Name="IntroLogoRotate"
                                             Angle="-180"/>
                        </TransformGroup>
                    </Image.RenderTransform>
                    <Image.Effect>
                        <DropShadowEffect x:Name="LogoGlow"
                                          Color="Green"
                                          BlurRadius="60"
                                          ShadowDepth="0"
                                          Opacity="0"/>
                    </Image.Effect>
                </Image>

                <Image x:Name="Foxy"
                       Source="Assets/Fox.png"
                       Width="280"
                       Height="280"
                       RenderTransformOrigin="0.5,0.5"
                       Opacity="0">
                    <Image.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="FoxyScale"
                                            ScaleX="0.0"
                                            ScaleY="0.0"/>
                        </TransformGroup>
                    </Image.RenderTransform>
                </Image>

                <Border x:Name="IntroFlash"
                        Background="White"
                        Opacity="0"
                        IsHitTestVisible="False"
                        Width="3000"
                        Height="2000"/>
            </Grid>
        </Grid>

        <Grid x:Name="UserSelectionOverlay"
              Grid.RowSpan="5"
              Background="#E6000000"
              Visibility="Collapsed"
              Panel.ZIndex="99998"
              x:FieldModifier="public">
            <Border Background="#1A1A1A"
                    BorderBrush="{DynamicResource AccentBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="40"
                    MinWidth="600">
                <StackPanel>
                    <TextBlock Text="Quem está a jogar?"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontSize="32"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,30"/>
                    <ListBox x:Name="UserListBox"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             HorizontalAlignment="Center"
                             ItemContainerStyle="{StaticResource FocusableItemStyle}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"
                                           MaxWidth="600"
                                           HorizontalAlignment="Center"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Button Click="UserButton_Click"
                                        Tag="{Binding Username}"
                                        Style="{StaticResource SettingsButtonStyle}"
                                        Margin="10"
                                        Width="140"
                                        Height="160">
                                    <StackPanel>
                                        <Border Width="80"
                                                Height="80"
                                                CornerRadius="40"
                                                Background="#333"
                                                Margin="0,0,0,15">
                                            <TextBlock Text="{Binding Username, StringFormat={}{0:0}}"
                                                       FontSize="30"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Center"
                                                       Foreground="{DynamicResource textSecondary}"/>
                                        </Border>
                                        <TextBlock Text="{Binding Username}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   FontWeight="Bold"
                                                   FontSize="16"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button Content="+ Novo Utilizador"
                            Click="ShowAddUserModal_Click"
                            Style="{StaticResource SettingsButtonStyle}"
                            HorizontalAlignment="Center"
                            Margin="0,30,0,0"
                            Height="50"
                            Width="200"
                            Background="{DynamicResource AccentBrush}"
                            Foreground="Black"
                            FontWeight="Bold"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="AddUserModal"
              Grid.RowSpan="5"
              Background="#CC000000"
              Visibility="Collapsed"
              Panel.ZIndex="99999"
              x:FieldModifier="public">
            <Border Background="#222"
                    BorderBrush="{DynamicResource AccentBrush}"
                    BorderThickness="2"
                    CornerRadius="12"
                    Width="500"
                    VerticalAlignment="Center"
                    Padding="30">
                <StackPanel>
                    <TextBlock Text="Criar Novo Perfil"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontSize="24"
                               FontWeight="Bold"
                               Margin="0,0,0,20"/>

                    <TextBlock Text="Nome do Perfil (Ex: Kiko)"
                               Foreground="{DynamicResource textSecondary}"
                               Margin="0,0,0,5"/>
                    <TextBox x:Name="TxtNewUserName"
                             Height="40"
                             FontSize="16"
                             Padding="5"
                             Background="#333"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderThickness="0"/>

                    <TextBlock Text="Login Steam (Para troca automática)"
                               Foreground="{DynamicResource AccentBrush}"
                               FontWeight="Bold"
                               Margin="0,15,0,5"/>
                    <TextBox x:Name="TxtNewSteamLogin"
                             Height="40"
                             FontSize="14"
                             Padding="5"
                             Background="#333"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderThickness="0"/>
                    <TextBlock Text="*Apenas o nome de utilizador, não a password."
                               Foreground="{DynamicResource textSecondary}"
                               FontSize="10"
                               Margin="0,2,0,0"/>

                    <TextBlock Text="Steam Web API Key (Opcional)"
                               Foreground="{DynamicResource textSecondary}"
                               Margin="0,15,0,5"/>
                    <TextBox x:Name="TxtNewUserApiKey"
                             Height="40"
                             FontSize="14"
                             Padding="5"
                             Background="#333"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderThickness="0"/>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,30,0,0">
                        <Button Content="Cancelar"
                                Click="CancelAddUser_Click"
                                Style="{StaticResource SettingsButtonStyle}"
                                Height="40"
                                Width="100"
                                Margin="0,0,10,0"/>
                        <Button Content="Criar e Entrar"
                                Click="ConfirmAddUser_Click"
                                Style="{StaticResource SettingsButtonStyle}"
                                Height="40"
                                Width="140"
                                Background="{DynamicResource AccentBrush}"
                                Foreground="Black"
                                FontWeight="Bold"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="WelcomeOverlay"
              Grid.RowSpan="5"
              Background="#F2050505"
              Visibility="Collapsed"
              Panel.ZIndex="20000"
              x:FieldModifier="public">

            <Image x:Name="WelcomeBgImage"
                   Stretch="UniformToFill"
                   Opacity="0.3">
                <Image.Effect>
                    <BlurEffect Radius="50"/>
                </Image.Effect>
            </Image>

            <Grid Margin="100,60">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center"
                            Margin="0,0,50,0">
                    <TextBlock x:Name="WelcomeGreeting"
                               Text="Bem-vindo de volta!"
                               FontSize="32"
                               Foreground="{DynamicResource textSecondary}"
                               FontWeight="Light"/>

                    <TextBlock x:Name="WelcomeUser"
                               Text="Ratatouille"
                               FontSize="56"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontWeight="Bold"
                               Margin="0,0,0,30"/>

                    <Border Background="#33FFFFFF"
                            CornerRadius="8"
                            Padding="20">
                        <StackPanel>
                            <TextBlock Text="SUGESTÃO INTELIGENTE"
                                       Foreground="{DynamicResource AccentBrush}"
                                       FontWeight="Bold"
                                       FontSize="14"
                                       Margin="0,0,0,10"/>

                            <TextBlock x:Name="WelcomeReason"
                                       Text="Como tens jogado muitos RPGs ultimamente, achamos que está na hora de continuares a tua aventura em..."
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontSize="18"
                                       TextWrapping="Wrap"
                                       LineHeight="26"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal"
                                Margin="0,40,0,0">
                        <Button x:Name="BtnWelcomePlay"
                                Content="JOGAR AGORA"
                                Click="WelcomePlay_Click"
                                Style="{StaticResource PlayButtonStyle}"
                                Width="220"
                                Height="60"
                                FontSize="18"
                                Margin="0,0,20,0"/>

                        <Button x:Name="BtnWelcomeClose"
                                Content="Ir para a Biblioteca"
                                Click="WelcomeClose_Click"
                                Style="{StaticResource SettingsButtonStyle}"
                                Width="200"
                                Height="60"
                                FontSize="16"
                                Background="Transparent"
                                BorderBrush="White"
                                BorderThickness="1"/>
                    </StackPanel>
                </StackPanel>

                <Grid Grid.Column="1"
                      VerticalAlignment="Center"
                      HorizontalAlignment="Center">
                    <Border CornerRadius="12"
                            Width="400"
                            Height="600">
                        <Border.Effect>
                            <DropShadowEffect Color="Black"
                                              BlurRadius="40"
                                              ShadowDepth="10"
                                              Opacity="0.6"/>
                        </Border.Effect>
                        <Border.Background>
                            <ImageBrush x:Name="WelcomeGameCover"
                                        Stretch="UniformToFill"/>
                        </Border.Background>

                        <Grid VerticalAlignment="Bottom"
                              Background="#CC000000"
                              Height="100">
                            <TextBlock x:Name="WelcomeGameTitle"
                                       Text="ELDEN RING"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontSize="32"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"/>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>