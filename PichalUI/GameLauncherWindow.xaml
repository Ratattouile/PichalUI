<Window x:Class="PichalUI.GameLauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PichalUI"
        mc:Ignorable="d"
        Title="Pichal UI"
        Height="760"
        Width="1280"
        MinHeight="640"
        MinWidth="1000"
        Background="Transparent"
        Loaded="Window_Loaded"
        Closed="Window_Closed">

    <Window.Resources>
        <Style x:Key="InfoListStyle"
               TargetType="ListBox">
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="BorderThickness"
                    Value="2"/>
            <Setter Property="BorderBrush"
                    Value="Transparent"/>
            <Setter Property="Padding"
                    Value="5"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility"
                    Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility"
                    Value="Hidden"/>

            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin"
                         Value="True">
                    <Setter Property="BorderBrush"
                            Value="{DynamicResource AccentBrush}"/>
                    <Setter Property="Background"
                            Value="#11FFFFFF"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="Black"
                                              BlurRadius="10"
                                              ShadowDepth="2"
                                              Opacity="0.5"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="InfoTextBoxStyle"
               TargetType="TextBox">
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="BorderThickness"
                    Value="2"/>
            <Setter Property="BorderBrush"
                    Value="Transparent"/>
            <Setter Property="Foreground"
                    Value="Gray"/>
            <Setter Property="TextWrapping"
                    Value="Wrap"/>
            <Setter Property="IsReadOnly"
                    Value="True"/>

            <Style.Triggers>
                <Trigger Property="IsFocused"
                         Value="True">
                    <Setter Property="BorderBrush"
                            Value="{DynamicResource AccentBrush}"/>
                    <Setter Property="Foreground"
                            Value="White"/>
                    <Setter Property="Background"
                            Value="#11FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <SolidColorBrush x:Key="AccentBrush"
                         Color="#FF4758"/>
        <SolidColorBrush x:Key="TextPrimaryBrush"
                         Color="White"/>
        <SolidColorBrush x:Key="PanelBackgroundBrush"
                         Color="#D9101010"/>

        <Style TargetType="Button">
            <Setter Property="FocusVisualStyle"
                    Value="{x:Null}"/>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle"
                    Value="{x:Null}"/>
        </Style>

        <Style x:Key="SettingsButtonStyle"
               TargetType="Button">
            <Setter Property="Background"
                    Value="#33FFFFFF"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontSize"
                    Value="14"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="HorizontalContentAlignment"
                    Value="Left"/>
            <Setter Property="Padding"
                    Value="15,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="border"
                                        Property="Background"
                                        Value="#55FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsFocused"
                                     Value="True">
                                <Setter TargetName="border"
                                        Property="Background"
                                        Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground"
                                        Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernSlider"
               TargetType="Slider">
            <Setter Property="IsSnapToTickEnabled"
                    Value="True"/>
            <Setter Property="TickFrequency"
                    Value="5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border Name="TrackBackground"
                                    Background="#33FFFFFF"
                                    Height="4"
                                    CornerRadius="2"
                                    VerticalAlignment="Center"/>
                            <Canvas Name="PART_SelectionRange"/>
                            <Track Name="PART_Track">
                                <Track.Thumb>
                                    <Thumb Width="20"
                                           Height="20">
                                        <Thumb.Template>
                                            <ControlTemplate>
                                                <Border Background="White"
                                                        CornerRadius="10"
                                                        BorderThickness="0">
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="4"
                                                                          Opacity="0.5"/>
                                                    </Border.Effect>
                                                </Border>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToggleSwitch"
               TargetType="CheckBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Border x:Name="Back"
                                    Width="50"
                                    Height="26"
                                    CornerRadius="13"
                                    Background="#444"/>
                            <Ellipse x:Name="Dot"
                                     Width="20"
                                     Height="20"
                                     Fill="White"
                                     HorizontalAlignment="Left"
                                     Margin="3,0,0,0">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="4"
                                                      Opacity="0.3"/>
                                </Ellipse.Effect>
                            </Ellipse>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked"
                                     Value="True">
                                <Setter TargetName="Back"
                                        Property="Background"
                                        Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Dot"
                                        Property="HorizontalAlignment"
                                        Value="Right"/>
                                <Setter TargetName="Dot"
                                        Property="Margin"
                                        Value="0,0,3,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsTabStyle"
               TargetType="RadioButton">
            <Setter Property="Foreground"
                    Value="Gray"/>
            <Setter Property="FontSize"
                    Value="18"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <TextBlock Text="{TemplateBinding Content}"
                                       Foreground="{TemplateBinding Foreground}"
                                       VerticalAlignment="Center"
                                       Margin="20,0"/>
                            <Rectangle x:Name="Indicator"
                                       Width="4"
                                       HorizontalAlignment="Left"
                                       Fill="Transparent"
                                       RadiusX="2"
                                       RadiusY="2"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked"
                                     Value="True">
                                <Setter Property="Foreground"
                                        Value="{DynamicResource TextPrimaryBrush}"/>
                                <Setter Property="FontWeight"
                                        Value="Bold"/>
                                <Setter TargetName="Indicator"
                                        Property="Fill"
                                        Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsFocused"
                                     Value="True">
                                <Setter Property="Foreground"
                                        Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Border x:Name="MainBackground">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,2"
                                     EndPoint="1,2">
                    <GradientStop Color="#1A0A0D"
                                  Offset="-2"/>
                    <GradientStop Color="#FF681220"
                                  Offset="0.1"/>
                    <GradientStop Color="#701320"
                                  Offset="0.5"/>
                    <GradientStop Color="#A81826"
                                  Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="70"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Padding="0"
                    Background="Transparent">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="HeaderTitle"
                               Text="Pichal UI"
                               FontSize="18"
                               Foreground="White"
                               VerticalAlignment="Center"
                               Margin="16,0"
                               Grid.Column="0"/>
                    <Button x:Name="BtnRefresh"
                            Content="Rescan"
                            Margin="6"
                            Width="0"
                            Visibility="Collapsed"/>

                    <StackPanel Grid.Column="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <TextBlock x:Name="ClockTime"
                                   Text="12:00"
                                   Foreground="White"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                        <TextBlock x:Name="ClockDate"
                                   Text="Sáb, 22 Nov"
                                   Foreground="LightGray"
                                   FontSize="12"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                Margin="16,0">
                        <Image x:Name="ProfileImage"
                               Stretch="UniformToFill"
                               Height="35"
                               Width="35"
                               Margin="0,0,10,0"/>
                        <TextBlock x:Name="ProfileName"
                                   Text="User"
                                   FontSize="18"
                                   Foreground="White"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border x:Name="BannerArea"
                    Grid.Row="1"
                    Padding="0"
                    Background="Transparent">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Image x:Name="BannerImage"
                           Grid.ColumnSpan="4"
                           Stretch="UniformToFill"
                           Opacity="0.1"
                           IsHitTestVisible="False"
                           Height="0"/>

                    <TextBlock x:Name="BannerText"
                               FontSize="22"
                               Text="Home"
                               FontWeight="Bold"
                               Foreground="White"
                               VerticalAlignment="Center"
                               Margin="16,6"
                               Grid.Column="0"/>
                    <TextBlock x:Name="FriendsMenu"
                               FontSize="22"
                               Text="Friends"
                               FontWeight="Bold"
                               Foreground="Gray"
                               VerticalAlignment="Center"
                               Margin="16,6"
                               Grid.Column="1"/>
                    <TextBlock x:Name="SettingMenu"
                               FontSize="22"
                               Text="Settings"
                               FontWeight="Bold"
                               Foreground="Gray"
                               VerticalAlignment="Center"
                               Margin="16,6"
                               Grid.Column="2"/>
                </Grid>
            </Border>

            <Border Grid.Row="2"
                    x:Name="Carousel"
                    Height="340"
                    VerticalAlignment="Center"
                    ClipToBounds="False"
                    Padding="8">
                <ListBox x:Name="GamesListBox"
                         Grid.Row="3"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         ScrollViewer.CanContentScroll="False"
                         VirtualizingStackPanel.IsVirtualizing="False"
                         VerticalAlignment="Top"
                         Height="340"
                         ClipToBounds="False">

                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"
                                        IsItemsHost="True"
                                        VerticalAlignment="Top"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>

                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding"
                                    Value="0"/>
                            <Setter Property="Background"
                                    Value="Transparent"/>
                            <Setter Property="VerticalContentAlignment"
                                    Value="Top"/>
                            <Setter Property="VerticalAlignment"
                                    Value="Top"/>

                            <Setter Property="Margin"
                                    Value="4,40,4,0"/>

                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Grid Background="Transparent"
                                              RenderTransformOrigin="0.5, 0.0">
                                            <Grid.RenderTransform>
                                                <ScaleTransform x:Name="ScaleTrans"
                                                                ScaleX="1.0"
                                                                ScaleY="1.0"/>
                                            </Grid.RenderTransform>
                                            <ContentPresenter/>
                                        </Grid>

                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected"
                                                     Value="True">
                                                <Setter Property="Panel.ZIndex"
                                                        Value="9999"/>
                                                <Trigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="ScaleTrans"
                                                                             Storyboard.TargetProperty="ScaleX"
                                                                             To="1.6"
                                                                             Duration="0:0:0.20"
                                                                             DecelerationRatio="0.6"/>
                                                            <DoubleAnimation Storyboard.TargetName="ScaleTrans"
                                                                             Storyboard.TargetProperty="ScaleY"
                                                                             To="1.6"
                                                                             Duration="0:0:0.20"
                                                                             DecelerationRatio="0.6"/>

                                                            <ThicknessAnimation Storyboard.TargetProperty="Margin"
                                                                                To="45,40,45,0"
                                                                                Duration="0:0:0.20"
                                                                                DecelerationRatio="0.6"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.EnterActions>

                                                <Trigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="ScaleTrans"
                                                                             Storyboard.TargetProperty="ScaleX"
                                                                             To="1.0"
                                                                             Duration="0:0:0.20"
                                                                             DecelerationRatio="0.6"/>
                                                            <DoubleAnimation Storyboard.TargetName="ScaleTrans"
                                                                             Storyboard.TargetProperty="ScaleY"
                                                                             To="1.0"
                                                                             Duration="0:0:0.20"
                                                                             DecelerationRatio="0.6"/>
                                                            <ThicknessAnimation Storyboard.TargetProperty="Margin"
                                                                                To="4,40,4,0"
                                                                                Duration="0:0:0.20"
                                                                                DecelerationRatio="0.6"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.ExitActions>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid VerticalAlignment="Top">
                                <Border x:Name="CardBorder"
                                        Width="150"
                                        Height="150"
                                        CornerRadius="8">
                                    <Border.Background>
                                        <ImageBrush ImageSource="{Binding Cover}"
                                                    Stretch="UniformToFill"/>
                                    </Border.Background>
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="8"
                                                          ShadowDepth="3"
                                                          Opacity="0.4"/>
                                    </Border.Effect>

                                    <Grid x:Name="StoreOverlay"
                                          Visibility="Collapsed">
                                        <StackPanel VerticalAlignment="Center"
                                                    HorizontalAlignment="Center">
                                            <TextBlock Text="⌂"
                                                       FontSize="40"
                                                       Foreground="White"
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock Text="LOJA"
                                                       FontSize="14"
                                                       FontWeight="Bold"
                                                       Foreground="White"
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Canvas>
                                    <TextBlock x:Name="SideTitle"
                                               Text="{Binding Title}"
                                               Foreground="White"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"
                                               Width="300"
                                               Canvas.Left="0"
                                               Canvas.Top="100"
                                               Opacity="0">
                                    </TextBlock>
                                </Canvas>
                            </Grid>

                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                             Value="True">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="SideTitle"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="1.0"
                                                                 Duration="0:0:0.3"/>
                                                <DoubleAnimation Storyboard.TargetName="SideTitle"
                                                                 Storyboard.TargetProperty="(Canvas.Left)"
                                                                 From="120"
                                                                 To="155"
                                                                 Duration="0:0:0.3"
                                                                 DecelerationRatio="0.5"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="SideTitle"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="0.0"
                                                                 Duration="0:0:0.1"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.ExitActions>
                                </DataTrigger>

                                <DataTrigger Binding="{Binding Source}"
                                             Value="System">
                                    <Setter TargetName="StoreOverlay"
                                            Property="Visibility"
                                            Value="Visible"/>
                                    <Setter TargetName="CardBorder"
                                            Property="Background">
                                        <Setter.Value>
                                            <LinearGradientBrush StartPoint="0,0"
                                                                 EndPoint="1,1">
                                                <GradientStop Color="#FF4758"
                                                              Offset="0"/>
                                                <GradientStop Color="#FF2A2F"
                                                              Offset="1"/>
                                            </LinearGradientBrush>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Border Grid.Row="3"
                    x:Name="SettingsMenu"
                    Visibility="Collapsed"
                    Padding="0"
                    Background="Transparent">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Definições"
                               Foreground="White"
                               FontSize="42"
                               FontWeight="Bold"
                               VerticalAlignment="Top"
                               Margin="40,0,0,0"/>

                    <StackPanel x:Name="SettingsCategories"
                                Grid.Column="0"
                                Margin="40,60,0,0">
                        <RadioButton x:Name="BtnTabGeneral"
                                     Content="Geral"
                                     IsChecked="True"
                                     Style="{StaticResource SettingsTabStyle}"
                                     Height="50"
                                     Checked="Tab_Checked"
                                     Click="Category_Click"/>

                        <RadioButton x:Name="BtnTabSystem"
                                     Content="Sistema"
                                     Style="{StaticResource SettingsTabStyle}"
                                     Height="50"
                                     Checked="Tab_Checked"
                                     Click="Category_Click"/>

                        <RadioButton x:Name="BtnTabPersonalization"
                                     Content="Personalização"
                                     Style="{StaticResource SettingsTabStyle}"
                                     Height="50"
                                     Checked="Tab_Checked"
                                     Click="Category_Click"/>
                        <RadioButton x:Name="BtnTabAccount"
                                     Content="Conta"
                                     Style="{StaticResource SettingsTabStyle}"
                                     Height="50"
                                     Checked="Tab_Checked"
                                     Click="Category_Click"/>
                    </StackPanel>

                    <Border Grid.Column="1"
                            Background="#D9101010"
                            CornerRadius="16,0,0,16"
                            Margin="20,0,0,20"
                            Padding="40">
                        <Grid x:Name="SettingsContentArea">

                            <StackPanel x:Name="TabGeneral"
                                        Visibility="Visible">
                                <TextBlock Text="Geral"
                                           Foreground="{DynamicResource AccentBrush}"
                                           FontWeight="Bold"
                                           Margin="0,0,0,20"/>

                                <Grid Margin="0,0,0,30">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="50"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Volume Principal"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   FontSize="18"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="Saída de áudio do sistema"
                                                   Foreground="Gray"
                                                   FontSize="12"/>
                                    </StackPanel>
                                    <Slider x:Name="VolumeSlider"
                                            Grid.Column="1"
                                            Style="{StaticResource ModernSlider}"
                                            Minimum="0"
                                            Maximum="100"
                                            Value="50"
                                            ValueChanged="VolumeSlider_ValueChanged"
                                            Focusable="True"/>
                                    <TextBlock Text="{Binding ElementName=VolumeSlider, Path=Value, StringFormat={}{0:0}}"
                                               Grid.Column="2"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Right"/>
                                </Grid>

                                <Grid Margin="0,0,0,30">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Contador de FPS"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   FontSize="18"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="Overlay de desempenho em jogo"
                                                   Foreground="Gray"
                                                   FontSize="12"/>
                                    </StackPanel>
                                    <CheckBox x:Name="ToggleFPS"
                                              Grid.Column="1"
                                              Style="{StaticResource ToggleSwitch}"
                                              Focusable="True"/>
                                </Grid>

                                <TextBlock Text="Armazenamento"
                                           Foreground="{DynamicResource AccentBrush}"
                                           FontWeight="Bold"
                                           Margin="0,0,0,15"/>
                                <Border Background="#22FFFFFF"
                                        CornerRadius="8"
                                        Padding="15">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,10">
                                            <TextBlock Text="Disco Local (C:)"
                                                       Foreground="White"
                                                       FontWeight="SemiBold"/>
                                            <TextBlock x:Name="StorageText"
                                                       Text="Calculando..."
                                                       Foreground="Gray"
                                                       HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Grid Height="10">
                                            <Border Background="#33000000"
                                                    CornerRadius="5"/>
                                            <ProgressBar x:Name="StorageBar"
                                                         Value="0"
                                                         Maximum="100"
                                                         BorderThickness="0"
                                                         Background="Transparent"
                                                         Foreground="{DynamicResource AccentBrush}"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel x:Name="TabSystem"
                                        Visibility="Collapsed">
                                <TextBlock Text="Rede e Hardware"
                                           Foreground="{DynamicResource AccentBrush}"
                                           FontWeight="Bold"
                                           Margin="0,0,0,20"/>

                                <Grid Margin="0,0,0,30">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Rede Wi-Fi"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   FontSize="18"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock x:Name="WifiStatusText"
                                                   Text="Estado da conexão"
                                                   Foreground="Gray"
                                                   FontSize="12"/>
                                    </StackPanel>
                                    <Border Grid.Column="1"
                                            CornerRadius="4"
                                            Padding="15,5"
                                            x:Name="BtnWifiBorder">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background"
                                                        Value="#33FFFFFF"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ElementName=BtnWifiReal, Path=IsFocused}"
                                                                 Value="True">
                                                        <Setter Property="Background"
                                                                Value="{DynamicResource AccentBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="Configurar >"
                                                   Foreground="White"
                                                   FontWeight="Bold"/>
                                    </Border>
                                    <Button x:Name="BtnWifiReal"
                                            Click="OpenWifiModal_Click"
                                            Grid.ColumnSpan="2"
                                            Opacity="0"
                                            Focusable="True"/>
                                </Grid>

                                <Border Background="#11FFFFFF"
                                        CornerRadius="8"
                                        Padding="15"
                                        Margin="0,0,0,30">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,10">
                                            <TextBlock Text="Processador (CPU)"
                                                    Foreground="Gray"/>
                                            <TextBlock x:Name="CpuInfoText"
                                                    Text="A ler..."
                                                    Foreground="White"
                                                       HorizontalAlignment="Right"
                                                    MaxWidth="350"
                                                       TextTrimming="CharacterEllipsis"
                                                    FontWeight="SemiBold"/>
                                        </Grid>

                                        <Grid Margin="0,0,0,10">
                                            <TextBlock Text="Placa Gráfica (GPU)"
                                                    Foreground="Gray"/>
                                            <TextBlock x:Name="GpuInfoText"
                                                    Text="A ler..."
                                                    Foreground="White"
                                                       HorizontalAlignment="Right"
                                                    MaxWidth="350"
                                                       TextTrimming="CharacterEllipsis"
                                                    FontWeight="SemiBold"/>
                                        </Grid>

                                        <Grid Margin="0,0,0,10">
                                            <TextBlock Text="Resolução"
                                                    Foreground="Gray"/>
                                            <TextBlock x:Name="MonitorInfoText"
                                                    Text="-"
                                                    Foreground="White"
                                                    HorizontalAlignment="Right"/>
                                        </Grid>

                                        <Grid>
                                            <TextBlock Text="Memória RAM"
                                                    Foreground="Gray"/>
                                            <TextBlock x:Name="RamInfoText"
                                                    Text="-"
                                                    Foreground="White"
                                                    HorizontalAlignment="Right"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="Energia"
                                           Foreground="{DynamicResource AccentBrush}"
                                           FontWeight="Bold"
                                           Margin="0,0,0,15"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Content="Reiniciar"
                                            Height="50"
                                            Click="BtnRestart_Click"
                                            Style="{StaticResource SettingsButtonStyle}"
                                            Grid.Column="0"
                                            Focusable="True"/>
                                    <Button Content="Desligar"
                                            Height="50"
                                            Click="BtnShutdown_Click"
                                            Style="{StaticResource SettingsButtonStyle}"
                                            Grid.Column="2"
                                            Focusable="True">
                                        <Button.Foreground>
                                            <SolidColorBrush Color="#FF4758"/>
                                        </Button.Foreground>
                                    </Button>
                                </Grid>
                            </StackPanel>

                            <StackPanel x:Name="TabPersonalization"
                                        Visibility="Collapsed">
                                <TextBlock Text="Temas Visuais"
                                           Foreground="{DynamicResource AccentBrush}"
                                           FontWeight="Bold"
                                           Margin="0,0,0,20"/>

                                <Button Content="Pichalnovense (Oficial)"
                                        Height="50"
                                        Margin="0,0,0,10"
                                        Click="BtnThemePichal_Click"
                                        Style="{StaticResource SettingsButtonStyle}"
                                        Focusable="True"/>
                                <Button Content="Pichal Red (Clássico)"
                                        Height="50"
                                        Margin="0,0,0,10"
                                        Click="BtnThemeRed_Click"
                                        Style="{StaticResource SettingsButtonStyle}"
                                        Focusable="True"/>
                                <Button Content="Deep Blue"
                                        Height="50"
                                        Margin="0,0,0,10"
                                        Click="BtnThemeBlue_Click"
                                        Style="{StaticResource SettingsButtonStyle}"
                                        Focusable="True"/>
                                <Button Content="OLED Black"
                                        Height="50"
                                        Margin="0,0,0,10"
                                        Click="BtnThemeDark_Click"
                                        Style="{StaticResource SettingsButtonStyle}"
                                        Focusable="True"/>
                            </StackPanel>

                            <StackPanel x:Name="TabAccount"
                                        Visibility="Collapsed">
                                <TextBlock Text="A Minha Conta"
                                           Foreground="{DynamicResource AccentBrush}"
                                           FontWeight="Bold"
                                           Margin="0,0,0,20"/>

                                <Border Background="#22FFFFFF"
                                        CornerRadius="12"
                                        Padding="20"
                                        Margin="0,0,0,30">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Center"
                                                    Margin="0,0,0,20">
                                            <Image Source="{Binding ElementName=ProfileImage, Path=Source}"
                                                   Width="60"
                                                   Height="60"
                                                   Margin="0,0,15,0">
                                                <Image.Clip>
                                                    <EllipseGeometry Center="30,30"
                                                                     RadiusX="30"
                                                                     RadiusY="30"/>
                                                </Image.Clip>
                                            </Image>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ElementName=ProfileName, Path=Text}"
                                                           FontSize="24"
                                                           FontWeight="Bold"
                                                           Foreground="White"/>
                                                <TextBlock Text="Sessão Iniciada"
                                                           Foreground="{DynamicResource AccentBrush}"
                                                           FontSize="12"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <Button x:Name="BtnRelogin"
                                                Content="Trocar Conta / Refresh"
                                                Height="45"
                                                Style="{StaticResource SettingsButtonStyle}"
                                                Click="BtnConnectSteam_Click"
                                                Focusable="True"/>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="Integrações"
                                           Foreground="Gray"
                                           Margin="0,0,0,10"/>
                                <Button Content="Associar Spotify (Em Breve)"
                                        Height="45"
                                        IsEnabled="False"
                                        Opacity="0.5"
                                        Style="{StaticResource SettingsButtonStyle}"
                                        Margin="0,0,0,10"/>
                                <Button Content="Associar Discord (Em Breve)"
                                        Height="45"
                                        IsEnabled="False"
                                        Opacity="0.5"
                                        Style="{StaticResource SettingsButtonStyle}"/>
                            </StackPanel>

                        </Grid>
                    </Border>

                    <Grid x:Name="WifiSelectorModal"
                          Grid.ColumnSpan="2"
                          Background="#F2000000"
                          Visibility="Collapsed">
                        <Border Width="500"
                                Height="Auto"
                                VerticalAlignment="Center"
                                Background="#1A1A1A"
                                CornerRadius="12"
                                BorderBrush="#333"
                                BorderThickness="1">
                            <Grid Margin="30">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="Redes Wi-Fi"
                                           Foreground="White"
                                           FontSize="28"
                                           FontWeight="Bold"
                                           Margin="0,0,0,20"/>

                                <ListBox x:Name="WifiListBox"
                                         Grid.Row="1"
                                         Height="300"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         SelectionChanged="WifiListBox_SelectionChanged">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding"
                                                    Value="10"/>
                                            <Setter Property="Margin"
                                                    Value="0,0,0,5"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="Bd"
                                                                Background="#22FFFFFF"
                                                                CornerRadius="6"
                                                                Padding="15">
                                                            <Grid>
                                                                <TextBlock Text="{Binding SSID}"
                                                                           Foreground="White"
                                                                           FontWeight="Bold"
                                                                           FontSize="16"/>
                                                                <TextBlock Text="{Binding SignalStrength}"
                                                                           Foreground="Gray"
                                                                           HorizontalAlignment="Right"/>
                                                            </Grid>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsSelected"
                                                                     Value="True">
                                                                <Setter TargetName="Bd"
                                                                        Property="Background"
                                                                        Value="{DynamicResource AccentBrush}"/>
                                                                <Setter Property="Foreground"
                                                                        Value="Black"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>

                                <StackPanel x:Name="WifiPasswordPanel"
                                            Grid.Row="2"
                                            Visibility="Collapsed"
                                            Margin="0,20,0,0">
                                    <TextBlock Text="Password da Rede:"
                                               Foreground="Gray"
                                               Margin="0,0,0,5"/>
                                    <PasswordBox x:Name="WifiPasswordBox"
                                                 Height="40"
                                                 FontSize="16"
                                                 Background="#333"
                                                 Foreground="White"
                                                 BorderThickness="0"
                                                 Padding="10,5"
                                                 VerticalContentAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Grid.Row="3"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            Margin="0,30,0,0">
                                    <Button Content="Cancelar"
                                            Click="CloseWifiModal_Click"
                                            Width="100"
                                            Height="40"
                                            Background="Transparent"
                                            Foreground="White"
                                            Margin="0,0,10,0"/>

                                    <Button x:Name="BtnConnectWifi"
                                            Content="Ligar"
                                            Click="ConnectWifi_Click"
                                            Width="120"
                                            Height="40"
                                            Background="{DynamicResource AccentBrush}"
                                            Foreground="Black"
                                            FontWeight="Bold">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius"
                                                        Value="6"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>


            <Border Grid.Row="3"
                    x:Name="InfoArea"
                    Background="Transparent"
                    Padding="0"
                    Visibility="Visible">

                <Grid HorizontalAlignment="Center"
                      Width="1150">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="0,0,0,20">
                        <Image x:Name="HeroCover"
                               Width="0"
                               Height="0"
                               Visibility="Collapsed"/>
                        <StackPanel>
                            <TextBlock x:Name="HeroTitle"
                                       Text="Select a game"
                                       FontSize="36"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       Height="0"
                                       Width="0"/>
                            <StackPanel Orientation="Horizontal"
                                        Margin="0,10,0,0">
                                <Button x:Name="StartBtn"
                                        Content="JOGAR"
                                        Width="0"
                                        Height="0"
                                        Background="#FFCC00"
                                        FontWeight="Bold"
                                        Margin="0,0,10,0"/>
                                <Button x:Name="InstallBtn"
                                        Content="Instalar"
                                        Width="0"
                                        Height="0"
                                        Visibility="Collapsed"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <Border Grid.Row="1"
                            CornerRadius="16"
                            Margin="0,0,0,20"
                            Background="#801D1D1D"
                            Padding="20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="300"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="300"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Game Completion"
                                           Foreground="White"
                                           FontWeight="SemiBold"
                                           FontSize="16"/>
                                <TextBlock x:Name="Info_CompletionPercent"
                                           Text="0%"
                                           FontSize="48"
                                           FontWeight="Bold"
                                           Foreground="White"
                                           Margin="0,5,0,15"/>
                                <TextBlock x:Name="Info_OwnedOn"
                                           Text="Source: Steam"
                                           Foreground="LightGray"
                                           FontSize="14"
                                           Margin="0,0,0,15"/>
                                <TextBlock Text="Achievements"
                                           Foreground="White"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,5"/>
                                <ListBox x:Name="Info_AchievementsList"
                                         Height="140"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Foreground="LightGray"
                                         Style="{StaticResource InfoListStyle}"
                                         ScrollViewer.VerticalScrollBarVisibility="Hidden"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Margin="20,0">
                                <TextBlock Text="News and Updates"
                                           Foreground="White"
                                           FontWeight="SemiBold"
                                           FontSize="16"/>
                                <TextBox x:Name="Info_Feed"
                                         Style="{StaticResource InfoTextBoxStyle}"
                                         Text="Loading..."
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Foreground="LightGray"
                                         TextWrapping="Wrap"
                                         IsReadOnly="True"
                                         Height="250"
                                         Margin="0,5,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <Grid Margin="0,0,0,20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Total Playtime"
                                                   Foreground="White"
                                                   FontSize="12"/>
                                        <TextBlock x:Name="Info_Playtime"
                                                   Text="0.0 hrs"
                                                   Foreground="White"
                                                   FontSize="20"
                                                   FontWeight="Bold"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Last Played"
                                                   Foreground="White"
                                                   FontSize="12"/>
                                        <TextBlock x:Name="Info_LastPlayed"
                                                   Text="-"
                                                   Foreground="White"
                                                   FontSize="14"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Clips and Screenshots"
                                           Foreground="White"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,5"/>

                                <ListBox x:Name="Info_Screenshots"
                                         Style="{StaticResource InfoListStyle}"
                                         Height="160"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Hidden">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"
                                                       Width="280"/>
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="4"
                                                    ClipToBounds="True"
                                                    Margin="0,0,6,6">
                                                <Image Source="{Binding}"
                                                       Height="70"
                                                       Width="125"
                                                       Stretch="UniformToFill"/>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Row="3"
                    x:Name="FriendMenu"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                    </Grid.ColumnDefinitions>

                    <ListBox x:Name="FriendListBox"
                             SelectionChanged="FriendListBox_SelectionChanged"
                             Width="Auto"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.VerticalScrollBarVisibility="Hidden"
                             VirtualizingStackPanel.IsVirtualizing="True"
                             VirtualizingStackPanel.VirtualizationMode="Recycling"
                             KeyboardNavigation.TabNavigation="Local"
                             SelectionMode="Single"
                             Grid.Column="1"
                             HorizontalAlignment="Left"
                             Padding="0"
                             Margin="3">

                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="FocusVisualStyle"
                                        Value="{x:Null}"/>
                                <Setter Property="Foreground"
                                        Value="{DynamicResource TextPrimaryBrush}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd"
                                                    Background="Transparent"
                                                    Padding="2"
                                                    CornerRadius="5"
                                                    SnapsToDevicePixels="True">
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected"
                                                         Value="True">
                                                    <Setter TargetName="Bd"
                                                            Property="Background"
                                                            Value="{DynamicResource AccentBrush}"/>
                                                    <Setter Property="FontWeight"
                                                            Value="Bold"/>
                                                </Trigger>

                                                <Trigger Property="IsMouseOver"
                                                         Value="True">
                                                    <Setter TargetName="Bd"
                                                            Property="Background"
                                                            Value="#33FFFFFF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8"
                                        CornerRadius="4"
                                        Width="400"
                                        Margin="0,0,0,0"
                                        Background="{DynamicResource PanelBackgroundBrush}">
                                    <DockPanel>
                                        <Grid Width="40"
                                              Height="40"
                                              Margin="0,0,12,0"
                                              VerticalAlignment="Center">
                                            <Image Source="{Binding AvatarFull}"
                                                   Stretch="UniformToFill">
                                                <Image.Clip>
                                                    <RectangleGeometry Rect="0,0,40,40"
                                                                       RadiusX="4"
                                                                       RadiusY="4"/>
                                                </Image.Clip>
                                            </Image>
                                            <Ellipse Width="10"
                                                     Height="10"
                                                     HorizontalAlignment="Right"
                                                     VerticalAlignment="Bottom"
                                                     Fill="{Binding StatusColor}"
                                                     Stroke="{DynamicResource PanelBackgroundBrush}"
                                                     StrokeThickness="1"/>
                                        </Grid>

                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding PersonaName}"
                                                       FontSize="14"/>
                                            <TextBlock Text="{Binding StatusText}"
                                                       FontSize="11"
                                                       Opacity="0.7"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Grid.Column="2"
                            Background="#FF0E0E0E"
                            CornerRadius="12"
                            Margin="10,3,3,3"
                            ClipToBounds="True">
                        <Grid>
                            <TextBlock Text="Seleciona um amigo"
                                       Foreground="Gray"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="16">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility"
                                                Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ElementName=FriendListBox, Path=SelectedIndex}"
                                                         Value="-1">
                                                <Setter Property="Visibility"
                                                        Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <Grid DataContext="{Binding ElementName=FriendListBox, Path=SelectedItem}">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility"
                                                Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ElementName=FriendListBox, Path=SelectedIndex}"
                                                         Value="-1">
                                                <Setter Property="Visibility"
                                                        Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>

                                <Image Source="{Binding GameCoverUrl}"
                                       Stretch="UniformToFill"
                                       Opacity="0.3"
                                       Visibility="{Binding GameCoverVisibility}">
                                    <Image.Effect>
                                        <BlurEffect Radius="40"/>
                                    </Image.Effect>
                                </Image>

                                <ScrollViewer VerticalScrollBarVisibility="Hidden"
                                              Margin="25">
                                    <StackPanel>

                                        <StackPanel Orientation="Horizontal"
                                                    Margin="0,0,0,30">
                                            <Border CornerRadius="50"
                                                    Width="100"
                                                    Height="100"
                                                    Margin="0,0,0,0">
                                                <Border.Effect>
                                                    <DropShadowEffect Color="{Binding StatusColor.Color}"
                                                                      BlurRadius="20"
                                                                      ShadowDepth="0"
                                                                      Opacity="0.6"/>
                                                </Border.Effect>
                                                <Image Source="{Binding AvatarFull}"
                                                       Stretch="UniformToFill">
                                                    <Image.Clip>
                                                        <EllipseGeometry Center="50,50"
                                                                         RadiusX="40"
                                                                         RadiusY="40"/>
                                                    </Image.Clip>
                                                </Image>
                                            </Border>

                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding PersonaName}"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           FontSize="32"
                                                           FontWeight="Bold"
                                                           Margin="0,0,20,0"/>

                                                <Border Background="{Binding StatusColor}"
                                                        CornerRadius="4"
                                                        HorizontalAlignment="Left"
                                                        Padding="8,2"
                                                        Margin="0,5,0,0">
                                                    <TextBlock Text="{Binding StatusText}"
                                                               Foreground="Black"
                                                               FontWeight="Bold"
                                                               FontSize="12"/>
                                                </Border>

                                                <TextBlock Text="{Binding MutualFriendsText}"
                                                           Foreground="Gray"
                                                           FontSize="12"
                                                           Margin="0,5,0,0"
                                                           FontStyle="Italic"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Visibility="{Binding GameCoverVisibility}"
                                                    Margin="0,0,0,30">
                                            <TextBlock Text="A JOGAR AGORA"
                                                       Foreground="Gray"
                                                       FontSize="12"
                                                       FontWeight="Bold"
                                                       Margin="0,0,0,10"/>

                                            <Border Background="#22FFFFFF"
                                                    CornerRadius="8"
                                                    Padding="0">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Image Source="{Binding GameCoverUrl}"
                                                           Width="80"
                                                           Height="120"
                                                           Stretch="UniformToFill"
                                                           Margin="0">
                                                        <Image.Clip>
                                                            <RectangleGeometry Rect="0,0,80,120"
                                                                               RadiusX="8"
                                                                               RadiusY="8"/>
                                                        </Image.Clip>
                                                    </Image>

                                                    <StackPanel Grid.Column="1"
                                                                VerticalAlignment="Center"
                                                                Margin="15,0">
                                                        <TextBlock Text="{Binding GameExtraInfo}"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                                   FontSize="20"
                                                                   FontWeight="Bold"
                                                                   TextWrapping="Wrap"/>
                                                        <TextBlock Text="Na Steam"
                                                                   Foreground="{DynamicResource AccentBrush}"
                                                                   Margin="0,5,0,0"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </StackPanel>

                                        <StackPanel Margin="0,0,0,30">
                                            <TextBlock Text="ATIVIDADE RECENTE"
                                                       Foreground="Gray"
                                                       FontSize="12"
                                                       FontWeight="Bold"
                                                       Margin="0,0,0,10"/>

                                            <ListBox ItemsSource="{Binding RecentGames}"
                                                     Background="Transparent"
                                                     BorderThickness="0"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                                <ListBox.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ListBox.ItemsPanel>
                                                <ListBox.ItemContainerStyle>
                                                    <Style TargetType="ListBoxItem">
                                                        <Setter Property="FocusVisualStyle"
                                                                Value="{x:Null}"/>
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="ListBoxItem">
                                                                    <ContentPresenter/>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </ListBox.ItemContainerStyle>
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Margin="0,0,15,0"
                                                                    Width="93">
                                                            <Border CornerRadius="6"
                                                                    Height="140"
                                                                    Background="#222"
                                                                    ClipToBounds="True">
                                                                <Image Source="{Binding CoverUrl}"
                                                                       Width="93"
                                                                       Height="140"
                                                                       Stretch="UniformToFill"
                                                                       Margin="0">
                                                                    <Image.Clip>
                                                                        <RectangleGeometry Rect="0,0,93,140"
                                                                                           RadiusX="8"
                                                                                           RadiusY="8"/>
                                                                    </Image.Clip>
                                                                </Image>
                                                            </Border>
                                                            <TextBlock Text="{Binding Name}"
                                                                       Foreground="White"
                                                                       FontSize="11"
                                                                       FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Margin="0,5,0,0"/>
                                                            <TextBlock Text="{Binding Playtime2Weeks}"
                                                                       Foreground="Gray"
                                                                       FontSize="10"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>

                                            <TextBlock Text="Nenhuma atividade recente ou perfil privado."
                                                       Foreground="Gray"
                                                       FontStyle="Italic"
                                                       Opacity="0.6"
                                                       Margin="0,10,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility"
                                                                Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding RecentGames.Count}"
                                                                         Value="0">
                                                                <Setter Property="Visibility"
                                                                        Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>

                                        <TextBlock Text="DETALHES TÉCNICOS"
                                                   Foreground="Gray"
                                                   FontSize="12"
                                                   FontWeight="Bold"
                                                   Margin="0,0,0,10"/>
                                        <Border Background="#11FFFFFF"
                                                CornerRadius="8"
                                                Padding="15">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,10">
                                                    <TextBlock Text="Steam ID"
                                                               Foreground="Gray"/>
                                                    <TextBlock Text="{Binding SteamId}"
                                                               Foreground="White"
                                                               HorizontalAlignment="Right"
                                                               FontWeight="SemiBold"/>
                                                </Grid>
                                                <Grid>
                                                    <TextBlock Text="Link Perfil"
                                                               Foreground="Gray"/>
                                                    <TextBlock Text="Public"
                                                               Foreground="White"
                                                               HorizontalAlignment="Right"
                                                               FontWeight="SemiBold"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <Button Content="Ver Perfil Completo"
                                                Height="50"
                                                Margin="0,30,0,0"
                                                Background="{DynamicResource AccentBrush}"
                                                Foreground="Black"
                                                FontWeight="Bold"
                                                FontSize="16"
                                                BorderThickness="0"
                                                Command="{Binding DataContext.OpenFriendProfileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding ProfileUrl}">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius"
                                                            Value="8"/>
                                                </Style>
                                            </Button.Resources>
                                        </Button>

                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Row="4"
                    Height="30"
                    Background="#06080C"
                    Padding="10,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusLabel"
                               Text="Ready"
                               Foreground="Gray"
                               VerticalAlignment="Center"/>
                    <Button x:Name="BtnConnectSteam"
                            Content="Connect Steam"
                            Grid.Column="1"
                            Width="100"
                            Height="20"
                            Margin="10,0"/>
                    <TextBlock Text="v0.3.0 - alpha"
                               Foreground="Gray"
                               Grid.Column="2"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="LoadingOverlay"
              Grid.RowSpan="5"
              Background="#D9000000"
              Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center">
                <TextBlock x:Name="LoadingText"
                           Text="A carregar..."
                           Foreground="White"
                           FontSize="24"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"/>

                <ProgressBar IsIndeterminate="True"
                             Width="200"
                             Height="4"
                             BorderThickness="0"
                             Background="#33FFFFFF"
                             Foreground="#FFCC00"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>