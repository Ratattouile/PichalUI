<Window x:Class="PichalUI.GameLauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PichalUI"
        mc:Ignorable="d"
        Title="Pichal UI"
        Height="760"
        Width="1280"
        MinHeight="640"
        MinWidth="1000"
        Background="Transparent"
        Loaded="Window_Loaded"
        Closed="Window_Closed">
    <!-- Resources -->
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="FocusVisualStyle"
                    Value="{x:Null}"/>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle"
                    Value="{x:Null}"/>
        </Style>

        <!-- Estilo para os items da InfoList: substitui a caixa picotada por borda arredondada / glow sutil -->
        <Style x:Key="InfoListItemStyle"
               TargetType="ListBoxItem">
            <Setter Property="Padding"
                    Value="10"/>
            <Setter Property="Margin"
                    Value="4"/>
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                BorderThickness="0">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <!-- selection -->
                            <Trigger Property="IsSelected"
                                     Value="True">
                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="#2A2F33"/>
                            </Trigger>

                            <!-- hover -->
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="#232629"/>
                            </Trigger>

                            <!-- focused: mostrar uma borda suave (substitui o 'picotado') -->
                            <Trigger Property="IsFocused"
                                     Value="True">
                                <Setter TargetName="Bd"
                                        Property="BorderBrush"
                                        Value="#FF8A50"/>
                                <!-- cor de destaque -->
                                <Setter TargetName="Bd"
                                        Property="BorderThickness"
                                        Value="2"/>
                                <Setter TargetName="Bd"
                                        Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#FF8A50"
                                                          BlurRadius="10"
                                                          Opacity="0.15"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Border>
            <Border.Background>
                <LinearGradientBrush
                    StartPoint="0,2"
                    EndPoint="1,2">
                    <GradientStop Color="#1A0A0D"
                                  Offset="-2"/>
                    <GradientStop Color="#FF681220"
                                  Offset="0.1"/>
                    <GradientStop Color="#701320"
                                  Offset="0.5"/>
                    <GradientStop Color="#A81826"
                                  Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <!-- header -->
                <RowDefinition Height="70"/>
                <!-- banner -->
                <RowDefinition Height="Auto"/>
                <!-- carousel -->
                <RowDefinition Height="300*"/>
                <!-- info -->
                <RowDefinition Height="Auto"/>
                <!-- footer -->
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Border Grid.Row="0"
                    Padding="0"
                    Background="Transparent">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="200*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="HeaderTitle"
                               Text="Pichal UI"
                               FontSize="18"
                               Foreground="White"
                               VerticalAlignment="Center"
                               Margin="6"
                               Grid.Column="0"/>
                    <Button x:Name="BtnRefresh"
                            Content="Rescan"
                            Margin="6"
                            Width="0"/>
                    <Image x:Name="ProfileImage"
                           Grid.Column="1"
                           Stretch="UniformToFill"
                           Height="35"
                           Width="35"
                           HorizontalAlignment="Right"/>
                    <TextBlock x:Name="ProfileName"
                               Text="a"
                               FontSize="18"
                               Foreground="White"
                               VerticalAlignment="Center"
                               Padding="8"
                               Grid.Column="2"
                               HorizontalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- BANNER -->
            <Border x:Name="BannerArea"
                    Grid.Row="1"
                    Padding="0"
                    Background="Transparent"
                    x:FieldModifier="public">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="200*"/>
                    </Grid.ColumnDefinitions>
                    <Image x:Name="BannerImage"
                           Stretch="UniformToFill"
                           Height="0"/>
                    <TextBlock x:Name="BannerText"
                               FontSize="22"
                               Text="Home"
                               FontWeight="Bold"
                               Foreground="White"
                               VerticalAlignment="Center"
                               Margin="6"
                               Grid.Column="0"/>
                    <TextBlock x:Name="FriendsMenu"
                               FontSize="22"
                               Text="Friends"
                               FontWeight="Bold"
                               Foreground="#FF776464"
                               VerticalAlignment="Center"
                               Margin="6"
                               Grid.Column="1"/>
                    <TextBlock FontSize="22"
                               Text="Settings"
                               FontWeight="Bold"
                               Foreground="Gray"
                               VerticalAlignment="Center"
                               Margin="6"
                               Grid.Column="2"/>
                </Grid>
            </Border>

            <Border Grid.Row="3"
                    x:Name="FriendMenu"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                    </Grid.ColumnDefinitions>
                    <ListBox
                        x:Name="FriendListBox"
                        Width="Auto"
                        Background="Transparent"
                        BorderThickness="0"
                        ScrollViewer.VerticalScrollBarVisibility="Hidden"
                        VirtualizingStackPanel.IsVirtualizing="True"
                        VirtualizingStackPanel.VirtualizationMode="Recycling"
                        KeyboardNavigation.TabNavigation="Local"
                        SelectionMode="Single"
                        Grid.Column="1"
                        HorizontalAlignment="Left"
                        Padding="0">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <!-- remove o focus adorner padrão (ESTA MERDA NÃO FUNCIONA AQUI CRL FODASSE!!!! App.xaml -> Solução) -->
                                <Setter Property="FocusVisualStyle"
                                        Value="{x:Null}"/>
                                <!-- remove o highlight do tab/focus na template abaixo -->
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd"
                                                    Background="Transparent"
                                                    Padding="2"
                                                    CornerRadius="2"
                                                    SnapsToDevicePixels="True">
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </Border>

                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected"
                                                         Value="True">
                                                    <Setter TargetName="Bd"
                                                            Property="Background">
                                                        <Setter.Value>
                                                            <LinearGradientBrush StartPoint="0,2"
                                                                    EndPoint="1,0">
                                                                <GradientStop Color="#FF4758"
                                                                        Offset="0"/>
                                                                        <GradientStop Color="#FFF1A0A8"
                                                                        Offset="0.5"/>
                                                                <GradientStop Color="#FFFF3348"
                                                                        Offset="1.0"/>
                                                            </LinearGradientBrush>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver"
                                                         Value="True">
                                                    <Setter TargetName="Bd"
                                                            Property="Background"
                                                            Value="#FF4758"/>
                                                </Trigger>
                                                <Trigger Property="IsFocused"
                                                         Value="True">
                                                    <Setter TargetName="Bd"
                                                            Property="BorderBrush"
                                                            Value="Transparent"/>
                                                    <Setter TargetName="Bd"
                                                            Property="BorderThickness"
                                                            Value="0"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8"
                                        CornerRadius="2"
                                        Background="#240E12"
                                        Width="400">
                                    <DockPanel>
                                        <Grid Width="40"
                                              Height="40"
                                              Margin="0,0,8,0"
                                              VerticalAlignment="Center">
                                            <Image Source="{Binding AvatarFull}"
                                                   Stretch="UniformToFill"/>
                                        </Grid>

                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding PersonaName}"
                                                       FontWeight="Bold"
                                                       Foreground="White"/>
                                            <TextBlock Text="{Binding SteamId}"
                                                       FontSize="11"
                                                       Foreground="LightGray"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border
                        x:Name="FriendsInfo"
                        Background="#240E12"
                        Grid.Column="2"
                        Margin="3"
                        CornerRadius="2">

                    </Border>
                </Grid>
            </Border>


            <!-- CAROUSEL -->
            <Border Grid.Row="2"
                    Background="Transparent"
                    ClipToBounds="True"
                    Visibility="Visible"
                    x:Name="Carousel">
                <Canvas x:Name="GamesViewport"
                        Height="350"
                        Focusable="True"
                        KeyboardNavigation.TabNavigation="Local">
                    <Canvas x:Name="GamesInner"
                            Height="350"
                            Focusable="True"/>

                    <Border x:Name="ScanOverlay"
                            Background="#B60A0E14"
                            Visibility="Collapsed"
                            Width="Auto"
                            Height="Auto">
                        <Canvas x:Name="ScanCanvas"/>
                    </Border>

                    <!-- floating title -->
                    <Border x:Name="FloatingTitleBorder"
                            Width="800"
                            Height="48"
                            Background="Transparent"
                            CornerRadius="0"
                            Visibility="Collapsed">
                        <TextBlock x:Name="FloatingTitleText"
                                   Margin="0,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="White"
                                   FontSize="20"
                                   FontWeight="SemiBold"/>
                    </Border>

                    <Border x:Name="FloatingOpenBorder"
                            Width="800"
                            Height="48"
                            Background="Transparent"
                            CornerRadius="0"
                            Visibility="Collapsed">
                        <TextBlock Text="Press A"
                                   Margin="0,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="White"
                                   FontSize="20"
                                   FontWeight="SemiBold"/>
                    </Border>
                </Canvas>
            </Border>

            <!-- INFO AREA -->
            <Border Grid.Row="3"
                    Background="Transparent"
                    Padding="0"
                    Visibility="Visible"
                    x:Name="InfoArea">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="0"/>
                        <!-- hero row -->
                        <RowDefinition Height="Auto"/>
                        <!-- metrics row (centrado) -->
                    </Grid.RowDefinitions>

                    <!-- HERO (linha 0) -->
                    <StackPanel Grid.Row="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left"
                                Margin="0,0,0,8">
                        <Image x:Name="HeroCover"
                               Width="240"
                               Height="140"
                               Stretch="UniformToFill"
                               Margin="8"/>
                        <StackPanel VerticalAlignment="Center"
                                    Margin="6,0">
                            <TextBlock x:Name="HeroTitle"
                                       Text="Select a game"
                                       FontSize="30"
                                       FontWeight="SemiBold"
                                       Foreground="White"
                                       TextWrapping="Wrap"
                                       Width="420"/>
                            <TextBlock x:Name="HeroSubtitle"
                                       Text=""
                                       FontSize="14"
                                       Foreground="LightGray"
                                       Margin="0,6,0,0"/>
                            <StackPanel Orientation="Horizontal"
                                        Margin="0,8,0,0">
                                <Button x:Name="StartBtn"
                                        Content="Start"
                                        Width="140"
                                        Height="36"
                                        Margin="0,0,12,0"/>
                                <!-- opcional: botão install/play (Vai de piça mas fica aqui até arranjar uma nova solução) -->
                                <Button x:Name="InstallBtn"
                                        Content="Install"
                                        Width="100"
                                        Height="36"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- METRICS (linha 1) - centrado -->
                    <Border Grid.Row="1"
                            CornerRadius="16"
                            Padding="18"
                            Margin="0"
                            Background="#33FF7A6C"
                            SnapsToDevicePixels="True"
                            HorizontalAlignment="Center"
                            Width="1000">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="300"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="320"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left: completion + achievements -->
                            <StackPanel Grid.Column="0"
                                        Margin="0">
                                <TextBlock Text="Game Completion"
                                           Foreground="White"
                                           FontWeight="SemiBold"
                                           FontSize="20"/>
                                <TextBlock x:Name="Info_CompletionPercent"
                                           Text="69%"
                                           FontSize="48"
                                           FontWeight="Bold"
                                           Foreground="White"
                                           Margin="0,6,0,12"/>
                                <TextBlock x:Name="Info_OwnedOn"
                                           Text=""
                                           Foreground="White"
                                           FontWeight="SemiBold"
                                           FontSize="20"
                                           Margin="0,6,0,12"/>
                                <TextBlock Text="Achievements"
                                           Foreground="White"
                                           FontWeight="SemiBold"
                                           Margin="0,8,0,6"/>
                                <ListBox x:Name="Info_AchievementsList"
                                         Height="120"
                                         Background="Transparent"
                                         Foreground="White"
                                         BorderThickness="0"/>
                            </StackPanel>

                            <!-- Middle: feed / tweets (Substituidos pelas "news" da steam OBG ELON POR TROCARES A API TODA DO TWITTER) -->
                            <StackPanel Grid.Column="1"
                                        Margin="12,0">
                                <TextBlock Text="News and Updates"
                                           Foreground="White"
                                           FontWeight="SemiBold"
                                           FontSize="16"/>
                                <TextBox x:Name="Info_Feed"
                                         Text="Loading..."
                                         AcceptsReturn="True"
                                         IsReadOnly="True"
                                         Background="Transparent"
                                         Foreground="White"
                                         BorderThickness="0"
                                         Height="320"
                                         FontSize="14"
                                         TextWrapping="Wrap"/>

                                <ListBox x:Name="Info_MediaItems"
                                         Margin="0,8,0,0"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         SelectionMode="Single"
                                         ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel IsItemsHost="True"
                                                       Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>

                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="8"
                                                    Margin="6"
                                                    Width="140"
                                                    Height="80"
                                                    Background="#22000000">
                                                <Image Source="{Binding}"
                                                       Stretch="UniformToFill"/>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>

                            <!-- Right: playtime, last played, screenshots (Last Played AINDA não está a funceminar)-->
                            <StackPanel Grid.Column="2"
                                        Margin="8">
                                <TextBlock Text="Total Playtime                         Last Played"
                                           Foreground="White"
                                           FontSize="13"/>
                                <TextBlock x:Name="Info_Playtime"
                                           Text="65.2 hrs"
                                           FontSize="20"
                                           Foreground="White"
                                           Margin="0,6,0,12"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="Last Played"
                                           Foreground="White"
                                           FontWeight="SemiBold"/>
                                <TextBlock x:Name="Info_LastPlayed"
                                           Text="30 mins ago"
                                           Foreground="White"
                                           Margin="0,6,0,12"/>
                                <TextBlock Text="Clips and Screenshots"
                                           Foreground="White"
                                           FontWeight="SemiBold"
                                           Margin="0,8,0,8"/>
                                <ListBox x:Name="Info_Screenshots"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         SelectionMode="Single"
                                         ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel IsItemsHost="True"
                                                       Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>

                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="8"
                                                    Margin="6"
                                                    Width="160"
                                                    Height="90"
                                                    Background="#22000000">
                                                <Image Source="{Binding}"
                                                       Stretch="UniformToFill"/>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- FOOTER (Só pra testes Retirar ou ocultar no final) -->
            <Border Grid.Row="4"
                    Height="34"
                    Padding="6"
                    Background="#06080C"
                    VerticalAlignment="Bottom">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="StatusLabel"
                               Text="Scanning..."
                               Foreground="White"
                               VerticalAlignment="Center"
                               Grid.Column="0"/>
                    <Button x:Name="BtnConnectSteam"
                            Content="Connect Steam"
                            Width="120"
                            Height="24"
                            Margin="6,0"
                            Grid.Column="1"/>
                    <TextBlock Grid.Column="2"
                               Text="v0.2.2 - alpha"
                               Foreground="LightGray"
                               VerticalAlignment="Center"
                               Margin="6,0"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>