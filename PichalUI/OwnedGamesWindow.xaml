<Window x:Class="PichalUI.OwnedGamesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Jogos não instalados"
        Height="640"
        Width="900"
        WindowStartupLocation="CenterOwner"
        Background="#0A0F1E">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Jogos na tua conta (não instalados)"
                FontSize="18"
                FontWeight="SemiBold"
                Foreground="White"
                Margin="6"/>

        <ScrollViewer Grid.Row="1"
                VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="GamesItemsControl">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border CornerRadius="8"
                                Margin="6"
                                Width="200"
                                Height="260"
                                Background="#202020">
                            <StackPanel>
                                <Image Source="{Binding Cover}"
                                        Height="120"
                                        Stretch="UniformToFill"/>
                                <TextBlock Text="{Binding Name}"
                                        TextWrapping="Wrap"
                                        Foreground="White"
                                        Margin="6,8,6,4"
                                        FontWeight="SemiBold"/>
                                <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        Margin="0,6">
                                    <Button Content="Install"
                                            Tag="{Binding AppId}"
                                            Width="84"
                                            Margin="6"
                                            Click="Install_Click"/>
                                    <Button Content="Store"
                                            Tag="{Binding AppId}"
                                            Width="84"
                                            Margin="6"
                                            Click="Store_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Button Grid.Row="2"
                Content="Fechar"
                Width="90"
                Height="30"
                HorizontalAlignment="Right"
                Margin="6"
                Click="Close_Click"/>
    </Grid>
</Window>
